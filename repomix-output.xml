  flex: 1;
  min-height: 10rem;
  flex-direction: column;
  gap: 0.875rem;
  padding: 1.125rem;
}

.description {
  display: -webkit-box;
  overflow: hidden;
  margin: 0;
  color: var(--color-text-muted, #a09da3);
  font-size: 0.875rem;
  line-height: 1.6;
  -webkit-box-orient: vertical;
