  overflow: hidden;
  background: var(--color-surface-raised, #19191d);
}

.image {
  object-fit: cover;
  transition: transform 450ms ease;
}

.card:hover .image {
  transform: scale(1.035);
}

.gradient {
  position: absolute;
  inset: 30% 0 0;
  background: linear-gradient(transparent, rgb(9 9 11 / 78%));
  pointer-events: none;
}

.title {
  position: absolute;
  right: 1.25rem;
  bottom: 1rem;
  left: 1.25rem;
