    transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.card:hover {
  transform: translateY(-2px);
  border-color: #c9c7bc;
  box-shadow: var(--theme-shadow-raised, 0 16px 36px -12px rgb(0 0 0 / 12%));
}

.imageFrame {
  position: relative;
  width: 100%;
  height: 18rem;
  overflow: hidden;
}

.image {
  object-fit: cover;
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.card:hover .image {
  transform: scale(1.035);
}

.gradient {
  position: absolute;
  z-index: 10;
  inset: 0;
  background-image: linear-gradient(
    to top,
    rgb(0 0 0 / 64%) 0%,
    rgb(0 0 0 / 18%) 35%,
    transparent 68%
  );
}

.studioName {
  position: absolute;
  z-index: 20;
  right: 1rem;
  bottom: 0.75rem;
  left: 1rem;
}

.card .studioName h3 {
  margin: 0;
  color: #fff;
  font-size: 1.25rem;
  font-weight: 400;
  line-height: 1.75rem;
  text-shadow:
    0 4px 3px rgb(0 0 0 / 0.07),
    0 2px 2px rgb(0 0 0 / 0.06);
}

.descriptionOverlay {
  position: absolute;
  z-index: 30;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  background-color: rgb(24 24 27 / 76%);
  backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card:hover .descriptionOverlay {
  opacity: 1;
}

.descriptionOverlay p {
  margin: 0;
  color: #fff;
  font-size: 0.875rem;
  line-height: 1.625;
  text-align: center;
}

.location {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  padding: 0.875rem;
  border-top: 1px solid var(--line);
  background-color: #fff;
  color: var(--muted);
  font-size: 0.875rem;
  font-weight: 500;
}

.locationIcon {
  width: 1rem;
  height: 1rem;
  color: var(--muted);
}

@media (prefers-reduced-motion: reduce) {
  .card,
  .image,
  .descriptionOverlay {
    transition: none;
  }

  .card:hover,
  .card:hover .image {
    transform: none;
  }
}
