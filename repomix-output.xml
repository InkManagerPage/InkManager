            ? [uid(2)]
            : n === 1 || n === 3
              ? [uid(2), uid(3)]
              : n === 4
                ? [uid(3)]
                : n === 6
                  ? [uid(4)]
                  : n === 8
                    ? [uid(5)]
                    : [];
        for (const [j, artistaId] of artistas.entries())
          await tx.cotizacion.upsert({
            where: { solicitudId_artistaId: { solicitudId, artistaId } },
            create: {
