      crearSuscripcion({ id: "artista", nombre: "Artista", email: "qa@example.test", rol: "ARTISTA", estudioId: null }, { plan: "INDIVIDUAL", ciclo: "MENSUAL" }),
      (error: unknown) => error instanceof HttpError && error.status === 503,
