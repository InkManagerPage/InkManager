  t.after(reemplazar(prisma.suscripcion, "findFirst", () => {
    throw new Error("No debe acceder a pagos");
  }));
  t.mock.method(globalThis, "fetch", () => { throw new Error("No debe consultar a Mercado Pago"); });
  const original = process.env;
