<file path="Back/src/bloqueos-agenda/bloqueos-agenda.service.ts">
import { DateTime } from "luxon";
import { HttpError } from "../errors/http-error.js";
import {
  objetoEntrada,
  validarIdConsulta,
  validarVersion,
} from "../solicitudes/solicitudes.validation.js";
import {
  conAgenda,
  crearDisponibilidad,
} from "../disponibilidad/disponibilidad.repository.js";
import { presentarDisponibilidad } from "../disponibilidad/disponibilidad.entity.js";
import { comprobarVersionDisponibilidad } from "../disponibilidad/disponibilidad.validation.js";
import { validarBloqueo } from "./bloqueos-agenda.validation.js";
import { buscarCruceCita } from "./bloqueos-agenda.repository.js";
export async function guardarBloqueo(
  usuarioId: string,
  identificador: unknown,
  entrada: unknown,
  bloqueoId?: unknown,
) {
  const artistaId = validarIdConsulta(identificador),
    id = bloqueoId === undefined ? undefined : validarIdConsulta(bloqueoId),
    b = objetoEntrada(entrada),
    version = validarVersion(b);
  return conAgenda(
    usuarioId,
    artistaId,
    true,
    async (tx, artista, d, puedeEditar, a) => {
      const datos = validarBloqueo(b, a.zonaHoraria);
      comprobarVersionDisponibilidad(d?.version || 0, version);
      if (id && !d?.bloqueos.some((x) => x.id === id))
        throw new HttpError(404, "No encontramos ese bloqueo en esta agenda.");
      const cruce = await buscarCruceCita(
        tx,
        artistaId,
        datos.inicioAt,
        datos.finAt,
      );
      if (cruce)
        throw new HttpError(
          409,
          `Hay un turno el ${DateTime.fromJSDate(cruce.inicioAt).setZone(a.zonaHoraria).toFormat("dd/MM/yyyy HH:mm")} dentro del bloqueo. Reprogramalo o cancelalo antes de bloquear esa fecha.`,
        );
      const raiz = d || (await crearDisponibilidad(tx, a, artistaId));
      if (
        raiz.bloqueos.some(
          (b) =>
            b.id !== id && b.inicioAt < datos.finAt && b.finAt > datos.inicioAt,
        )
      )
        throw new HttpError(
          409,
          "Ya hay un bloqueo que ocupa parte de ese período. Editá el bloqueo existente.",
        );
      const guardado = id
        ? await tx.bloqueoAgenda.update({ where: { id }, data: datos })
        : await tx.bloqueoAgenda.create({
            data: {
              ...datos,
              disponibilidadId: raiz.id,
              creadaPorId: usuarioId,
            },
          });
      const actualizada = await tx.disponibilidadArtista.update({
        where: { id: raiz.id },
        data: { version: { increment: 1 } },
        select: { version: true },
      });
      return presentarDisponibilidad(
        {
          ...raiz,
          version: actualizada.version,
          bloqueos: [
            ...raiz.bloqueos.filter((b) => b.id !== id),
            guardado,
          ].sort((a, b) => a.inicioAt.getTime() - b.inicioAt.getTime()),
        },
        artista,
        a.zonaHoraria,
        puedeEditar,
      );
    },
  );
}
export async function quitarBloqueo(
  usuarioId: string,
  identificador: unknown,
  identificadorBloqueo: unknown,
  entrada: unknown,
) {
  const artistaId = validarIdConsulta(identificador),
    id = validarIdConsulta(identificadorBloqueo),
    version = validarVersion(objetoEntrada(entrada));
  return conAgenda(
    usuarioId,
    artistaId,
    true,
    async (tx, artista, d, puedeEditar, a) => {
      comprobarVersionDisponibilidad(d?.version || 0, version);
      if (!d?.bloqueos.some((x) => x.id === id))
        throw new HttpError(404, "No encontramos ese bloqueo en esta agenda.");
      await tx.bloqueoAgenda.update({
        where: { id },
        data: { canceladoAt: new Date() },
      });
      const actualizada = await tx.disponibilidadArtista.update({
        where: { id: d.id },
        data: { version: { increment: 1 } },
        select: { version: true },
      });
      return presentarDisponibilidad(
        {
          ...d,
          version: actualizada.version,
          bloqueos: d.bloqueos.filter((b) => b.id !== id),
        },
        artista,
        a.zonaHoraria,
        puedeEditar,
      );
    },
  );
}
</file>

<file path="Back/src/bloqueos-agenda/bloqueos-agenda.validation.ts">
import { DateTime } from "luxon";
import { HttpError } from "../errors/http-error.js";
import { objetoEntrada } from "../solicitudes/solicitudes.validation.js";
import type { DatosBloqueo } from "./bloqueos-agenda.entity.js";
function fecha(valor: unknown, zona: string) {
  if (typeof valor !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(valor))
    throw new HttpError(400, "Elegí fechas válidas para el bloqueo.");
  const d = DateTime.fromISO(valor, { zone: zona });
  if (!d.isValid || d.year < 2000 || d.year > 2100 || d.toISODate() !== valor)
    throw new HttpError(400, "La fecha del bloqueo no es válida.");
  return d;
}
function hora(dia: DateTime, valor: unknown) {
  if (typeof valor !== "string" || !/^([01]\d|2[0-3]):[0-5]\d$/.test(valor))
    throw new HttpError(400, "Elegí horas válidas para el bloqueo.");
  const local = `${dia.toISODate()} ${valor}`,
    d = DateTime.fromFormat(local, "yyyy-MM-dd HH:mm", { zone: dia.zoneName! });
  if (
    !d.isValid ||
    d.toFormat("yyyy-MM-dd HH:mm") !== local ||
    d.getPossibleOffsets().length > 1
  )
    throw new HttpError(
      400,
      "Ese horario no existe o se repite por un cambio de hora. Elegí otro horario.",
    );
  return d;
}
export function validarBloqueo(
  entrada: unknown,
  zonaHoraria: string,
): DatosBloqueo {
  const b = objetoEntrada(entrada);
  if (
    typeof b.motivo !== "string" ||
    b.motivo.trim().length < 1 ||
    b.motivo.trim().length > 120
  )
    throw new HttpError(400, "El motivo debe tener entre 1 y 120 caracteres.");
  if (typeof b.diaCompleto !== "boolean")
    throw new HttpError(400, "Indicá si el bloqueo ocupa días completos.");
  const desde = fecha(b.desdeFecha, zonaHoraria),
    hasta = fecha(b.hastaFecha, zonaHoraria);
  const inicio = b.diaCompleto
      ? desde.startOf("day")
      : hora(desde, b.desdeHora),
    fin = b.diaCompleto
      ? hasta.plus({ days: 1 }).startOf("day")
      : hora(hasta, b.hastaHora);
  if (hasta.toISODate()! < desde.toISODate()! || fin <= inicio)
    throw new HttpError(
      400,
      "El final del bloqueo debe ser posterior al inicio.",
    );
  return {
    motivo: b.motivo.trim(),
    inicioAt: inicio.toJSDate(),
    finAt: fin.toJSDate(),
    diaCompleto: b.diaCompleto,
  };
}
</file>

