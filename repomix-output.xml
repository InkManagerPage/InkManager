<file path="Front/src/components/panel/PanelForm.tsx">
'use client';

import { useEffect, useRef, useState, type ChangeEvent, type ReactNode } from 'react';
import { flushSync } from 'react-dom';
import {
  Formik,
  Form,
  useField,
  useFormikContext,
  type FormikErrors,
  type FormikValues,
} from 'formik';
import BootstrapForm from 'react-bootstrap/Form';
import Spinner from 'react-bootstrap/Spinner';
import { useUnsavedChanges } from '@/components/forms/UnsavedChanges';
import styles from './workspace.module.css';

export function PanelForm<Values extends FormikValues>({
  initialValues,
  validate,
  onSave,
  onSaved,
  children,
  className,
  enableReinitialize = false,
}: {
  initialValues: Values;
  validate: (values: Values) => FormikErrors<Values>;
  onSave: (values: Values) => string | void | Promise<string | void>;
  onSaved?: () => void;
  children: ReactNode;
  className?: string;
  enableReinitialize?: boolean;
}) {
  const [submitted, setSubmitted] = useState(false);
  return (
    <Formik
      initialValues={initialValues}
      enableReinitialize={enableReinitialize}
      validate={validate}
      validateOnChange={submitted}
      validateOnBlur={submitted}
      onSubmit={async (values, helpers) => {
        helpers.setStatus('');
        try {
          const error = await onSave(values);
          if (error) {
            helpers.setStatus(error);
            return;
          }
          flushSync(() => {
            helpers.resetForm({ values });
            setSubmitted(false);
          });
          onSaved?.();
        } catch (cause) {
          helpers.setStatus(
            cause instanceof Error
              ? cause.message
              : 'No pudimos guardar los cambios. Intentá nuevamente.',
          );
        }
      }}
    >
      <Form noValidate className={className} onSubmitCapture={() => setSubmitted(true)}>
        <FormState />
        <FormContents>{children}</FormContents>
        <FormStatus />
      </Form>
    </Formik>
  );
}

function FormContents({ children }: { children: ReactNode }) {
  const { isSubmitting } = useFormikContext();
  return (
    <fieldset disabled={isSubmitting} aria-busy={isSubmitting || undefined}>
      {children}
    </fieldset>
  );
}

function FormState() {
  const { dirty, submitCount, isValidating, isSubmitting, errors, touched } = useFormikContext();
  const handled = useRef(0);
  const anchor = useRef<HTMLSpanElement>(null);
  useUnsavedChanges(dirty);
  useEffect(() => {
    if (
      !submitCount ||
      isValidating ||
      isSubmitting ||
      handled.current === submitCount ||
      !Object.keys(errors).length
    )
      return;
    const element = anchor.current
      ?.closest('form')
      ?.querySelector<HTMLElement>('[aria-invalid="true"]');
    if (element) {
      for (const details of element.closest('details') ? [element.closest('details')!] : [])
        details.open = true;
      const collapsed = element.closest('.accordion-collapse:not(.show)');
      const focus = () => {
        element.focus();
        if (document.activeElement === element) handled.current = submitCount;
      };
      if (collapsed) {
        collapsed
          .closest('.accordion-item')
          ?.querySelector<HTMLButtonElement>('.accordion-button[aria-expanded="false"]')
          ?.click();
      }
      const timer = setTimeout(focus, 0);
      return () => clearTimeout(timer);
    }
  }, [errors, isValidating, isSubmitting, submitCount, touched]);
  return <span ref={anchor} hidden />;
}

function FormStatus() {
  const { status } = useFormikContext();
  return status ? (
    <p role="alert" className={`${styles.notice} ${styles.error} mt-3`}>
      {String(status)}
    </p>
  ) : null;
}

export function PanelSubmitButton({
  children,
  disabled = false,
  pendingText = 'Guardando…',
}: {
  children: ReactNode;
  disabled?: boolean;
  pendingText?: string;
}) {
  const { isSubmitting } = useFormikContext();
  return (
    <button
      type="submit"
      className={styles.button}
      disabled={disabled || isSubmitting}
      aria-busy={isSubmitting || undefined}
    >
      {isSubmitting ? (
        <>
          <Spinner animation="border" size="sm" aria-hidden="true" className="me-2" />
          <span role="status">{pendingText}</span>
        </>
      ) : (
        children
      )}
    </button>
  );
}

export function PanelField({
  name,
  label,
  children,
  as,
  type = 'text',
  hint,
  ...props
}: {
  name: string;
  label: string;
  children?: ReactNode;
  as?: 'select' | 'textarea';
  type?: string;
  hint?: string;
  min?: number | string;
  max?: number | string;
  minLength?: number;
  maxLength?: number;
  rows?: number;
  required?: boolean;
  autoComplete?: string;
  step?: string | number;
  placeholder?: string;
}) {
  const [field, meta] = useField(name);
  const invalid = Boolean(meta.touched && meta.error);
  const id = `panel-field-${name}`;
  const { setFieldValue } = useFormikContext();
  const shared = {
    ...field,
    ...props,
    ...(as === 'select' && type === 'number'
      ? {
          onChange: (
            event: ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>,
          ) => {
            void setFieldValue(name, Number(event.target.value));
          },
        }
      : {}),
    'aria-invalid': invalid || undefined,
    'aria-describedby': invalid ? `${id}-error` : hint ? `${id}-hint` : undefined,
    isInvalid: invalid,
  };
  return (
    <BootstrapForm.Group className={styles.field} controlId={id}>
      <BootstrapForm.Label>
        {label}
        {props.required && <span className="visually-hidden"> (obligatorio)</span>}
      </BootstrapForm.Label>
      {as === 'select' ? (
        <BootstrapForm.Select {...shared}>{children}</BootstrapForm.Select>
      ) : (
        <BootstrapForm.Control {...shared} as={as} type={as === 'textarea' ? undefined : type} />
      )}
      {invalid && (
        <BootstrapForm.Control.Feedback type="invalid" id={`${id}-error`}>
          {meta.error}
        </BootstrapForm.Control.Feedback>
      )}
      {hint && <BootstrapForm.Text id={`${id}-hint`}>{hint}</BootstrapForm.Text>}
    </BootstrapForm.Group>
  );
}
</file>

<file path="Front/src/components/panel/PanelMessages.tsx">
'use client';

import { useEffect, useRef, useState, type FormEvent, type ReactNode } from 'react';
import { usePanelFilters } from '@/hooks/usePanelFilters';
import type { ClientePanel, ConversacionPanel } from '@/types/panel-artista';
import { Avatar, EmptyState, PageHeader, PanelIcon, SearchField } from './PanelUI';
import { mostrarFecha } from '@/lib/panel-artista';
import { nombreCanal } from '@/lib/canales-consulta';
import styles from '@/components/panel/workspace.module.css';
import chat from './messages.module.css';

export interface PanelMessagesProps {
  datos: { conversaciones: ConversacionPanel[]; borradoresMensajes?: Record<string, string> };
  buscarCliente: (id: string) => ClientePanel;
  leerConversacion: (id: string, canal: ConversacionPanel['canal'], hasta: string) => Promise<void>;
  enviarMensaje: (id: string, canal: ConversacionPanel['canal'], texto: string) => Promise<void>;
  guardarBorradorMensaje: (id: string, texto: string) => void;
  vincularConsulta: (
    id: string,
    canal: ConversacionPanel['canal'],
    solicitudId: string | null,
  ) => Promise<void>;
  consultas?: { id: string; titulo: string }[];
  conectado: boolean;
  errorConexion: string;
  conexion?: ReactNode;
}
const estadosMensaje = {
  RECIBIDO: '',
  ENVIANDO: 'Enviando…',
  ENVIADO: 'Enviado',
  ENTREGADO: 'Entregado',
  LEIDO: 'Leído',
  ERROR: 'No enviado',
  INCIERTO: 'Envío sin confirmar',
};
export function PanelMessages(props: PanelMessagesProps) {
  const {
    datos,
    buscarCliente,
    leerConversacion,
    enviarMensaje,
    guardarBorradorMensaje,
    vincularConsulta,
    consultas,
    conectado,
    errorConexion,
    conexion,
  } = props;
  const { params, update } = usePanelFilters();
  const busqueda = params.get('q') || '';
  const setBusqueda = (value: string) => update({ q: value || null }, true);
  const soloSinLeer = params.get('sinLeer') === '1';
  const canal = params.get('canal') || '';
  const canales = [...new Set(datos.conversaciones.map((hilo) => hilo.canal))];
  const borradores = datos.borradoresMensajes || {};
  const cercaDelFinal = useRef(true);
  const hiloAnterior = useRef<string | undefined>(undefined);
  const fin = useRef<HTMLDivElement>(null);
  const [guardando, setGuardando] = useState(false);
  const [error, setError] = useState('');
  const [ahora, setAhora] = useState(() => Date.now());
  useEffect(() => {
    const timer = setInterval(() => setAhora(Date.now()), 15000);
    return () => clearInterval(timer);
  }, []);
  const conversaciones = datos.conversaciones
    .filter((item) => !canal || item.canal === canal)
    .filter((item) => !soloSinLeer || item.sinLeer > 0)
    .filter((item) =>
      `${buscarCliente(item.clienteId).nombre} ${item.asunto}`
        .toLocaleLowerCase('es')
        .includes(busqueda.toLocaleLowerCase('es')),
    )
    .sort((a, b) => (b.mensajes.at(-1)?.fecha || '').localeCompare(a.mensajes.at(-1)?.fecha || ''));
  const seleccionada =
    datos.conversaciones.find((item) => item.id === params.get('conversacion')) ||
    (params.has('conversacion') || soloSinLeer ? undefined : conversaciones[0]);
  const cantidad = seleccionada?.mensajes.length || 0;
  const texto = seleccionada ? borradores[seleccionada.id] || '' : '';
  const ultimoRecibido = seleccionada?.mensajes.findLast((m) => !m.propio)?.fecha;
  const idSeleccionado = seleccionada?.id;
  const canalSeleccionado = seleccionada?.canal;
  const maximo = canalSeleccionado === 'INSTAGRAM' ? 1000 : 2000;
  const hiloAbierto = params.has('conversacion');
  const sinLeer = seleccionada?.sinLeer;
  const vencida = Boolean(
    seleccionada?.ventanaHasta && Date.parse(seleccionada.ventanaHasta) <= ahora,
  );
  const puedeResponder = conectado && seleccionada?.puedeResponder !== false;
  function setTexto(valor: string) {
    if (seleccionada) guardarBorradorMensaje(seleccionada.id, valor);
  }
  useEffect(() => {
    if (fin.current && (hiloAnterior.current !== seleccionada?.id || cercaDelFinal.current))
      fin.current.scrollTop = fin.current.scrollHeight;
    hiloAnterior.current = seleccionada?.id;
  }, [seleccionada?.id, cantidad]);
  useEffect(() => {
    if (
      idSeleccionado &&
      canalSeleccionado &&
      ultimoRecibido &&
      sinLeer &&
      (hiloAbierto || window.matchMedia('(min-width: 651px)').matches)
    )
      void leerConversacion(idSeleccionado, canalSeleccionado, ultimoRecibido);
  }, [idSeleccionado, canalSeleccionado, ultimoRecibido, sinLeer, leerConversacion, hiloAbierto]);
  function abrir(id: string) {
    setError('');
    update({ conversacion: id });
  }
  async function enviar(event: FormEvent) {
    event.preventDefault();
    if (
      !seleccionada ||
      guardando ||
      !puedeResponder ||
      vencida ||
      !texto.trim() ||
      texto.trim().length > maximo
    )
      return;
    await ejecutar(async () => {
      await enviarMensaje(seleccionada.id, seleccionada.canal, texto);
      setTexto('');
    });
  }
  async function ejecutar(accion: () => Promise<void>) {
    setGuardando(true);
    setError('');
    try {
      await accion();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'No pudimos completar la operación.');
    } finally {
      setGuardando(false);
    }
  }
  return (
    <>
      <PageHeader titulo="Mensajes" />
      {conexion}
      {!conexion && !conectado && (
        <p className={styles.notice}>Todavía no hay un canal conectado para este negocio.</p>
      )}
      {(error || errorConexion) && (
        <p className="alert alert-danger" role="alert">
          {error || errorConexion}
        </p>
      )}
      <div className={styles.toolbar}>
        <div className={styles.tabs}>
          <button
            aria-pressed={!soloSinLeer}
            className={!soloSinLeer ? styles.tabActive : ''}
            onClick={() => update({ sinLeer: null })}
          >
            Todos
          </button>
          <button
            aria-pressed={soloSinLeer}
            className={soloSinLeer ? styles.tabActive : ''}
            onClick={() => update({ sinLeer: '1' })}
          >
            Sin leer
          </button>
        </div>
        {(canales.length > 1 || canal) && (
          <select
            className="form-select w-auto"
            aria-label="Filtrar por canal"
            value={canal}
            onChange={(event) => update({ canal: event.target.value || null, conversacion: null })}
          >
            <option value="">Todos los canales</option>
            {canales.map((id) => (
              <option key={id} value={id}>
                {nombreCanal(id)}
              </option>
            ))}
          </select>
        )}
      </div>
      <section
        className={`${chat.messenger} ${params.has('conversacion') ? chat.mobileThread : ''}`}
        aria-label="Mensajes"
      >
        <aside className={chat.conversations}>
          <div className={chat.searchArea}>
            <SearchField
              value={busqueda}
              onChange={setBusqueda}
              placeholder="Buscar conversación"
            />
          </div>
          <div className={chat.conversationList}>
            {conversaciones.length ? (
              conversaciones.map((item) => {
                const cliente = buscarCliente(item.clienteId);
                const ultimo = item.mensajes.at(-1);
                return (
                  <button
                    className={`${chat.conversation} ${seleccionada?.id === item.id ? chat.selected : ''}`}
                    key={item.id}
                    onClick={() => abrir(item.id)}
                    aria-pressed={seleccionada?.id === item.id}
                  >
                    <Avatar nombre={cliente.nombre} />
                    <span className={chat.conversationInfo}>
                      <strong>{cliente.nombre}</strong>
                      <small>{nombreCanal(item.canal)}</small>
                      <span>
                        {borradores[item.id]
                          ? `Borrador: ${borradores[item.id]}`
                          : ultimo
                            ? `${ultimo.propio ? 'Vos: ' : ''}${ultimo.texto}`
                            : item.asunto}
                      </span>
                    </span>
                    <span className={chat.conversationMeta}>
                      {ultimo && <time>{mostrarFecha(ultimo.fecha)}</time>}
                      {item.sinLeer > 0 && <i>{item.sinLeer}</i>}
                    </span>
                  </button>
                );
              })
            ) : (
              <EmptyState titulo="Sin conversaciones" detalle="Probá otro nombre o proyecto." />
            )}
          </div>
        </aside>
        {seleccionada ? (
          <div className={chat.thread}>
            <header className={chat.threadHeader}>
              <button
                className={`${styles.textButton} ${chat.back}`}
                aria-label="Volver a conversaciones"
                onClick={() => update({ conversacion: null }, true)}
              >
                <PanelIcon nombre="volver" />
              </button>
              <Avatar nombre={buscarCliente(seleccionada.clienteId).nombre} />
              <div>
                <strong>{buscarCliente(seleccionada.clienteId).nombre}</strong>
                <span>
                  {nombreCanal(seleccionada.canal)}
                  {seleccionada.telefono && ' · ' + seleccionada.telefono}
                </span>
              </div>
            </header>
            {consultas && (
              <label className="p-2">
                Consulta vinculada
                <select
                  className="form-select form-select-sm"
                  value={seleccionada.solicitudId || ''}
                  disabled={guardando}
                  onChange={(e) => {
                    const id = e.target.value || null;
                    void ejecutar(() => vincularConsulta(seleccionada.id, seleccionada.canal, id));
                  }}
                >
                  <option value="">Sin consulta vinculada</option>
                  {consultas.map((c) => (
                    <option key={c.id} value={c.id}>
                      {c.titulo}
                    </option>
                  ))}
                </select>
              </label>
            )}
            <div
              className={chat.messages}
              ref={fin}
              aria-live="polite"
              onScroll={(event) => {
                const element = event.currentTarget;
                cercaDelFinal.current =
                  element.scrollHeight - element.scrollTop - element.clientHeight < 80;
              }}
              role="log"
              aria-label={`Conversación con ${buscarCliente(seleccionada.clienteId).nombre}`}
            >
              {seleccionada.mensajes.length ? (
                seleccionada.mensajes.map((mensaje, indice) => {
                  const dia = mensaje.fecha.slice(0, 10);
                  const nuevoDia =
                    indice === 0 || seleccionada.mensajes[indice - 1]?.fecha.slice(0, 10) !== dia;
                  return (
                    <div key={mensaje.id}>
                      {nuevoDia && (
                        <p className={chat.dateSeparator}>
                          {mostrarFecha(dia, { day: 'numeric', month: 'long' })}
                        </p>
                      )}
                      <div className={`${chat.message} ${mensaje.propio ? chat.outgoing : ''}`}>
                        <p>{mensaje.texto}</p>
                        <time dateTime={mensaje.fecha}>
                          {mostrarFecha(mensaje.fecha, { hour: '2-digit', minute: '2-digit' })}
                          {mensaje.propio && (
                            <span>{estadosMensaje[mensaje.estado || 'ENVIADO']}</span>
                          )}
                        </time>
                      </div>
                    </div>
                  );
                })
              ) : (
                <EmptyState
                  titulo="Empezá la conversación"
                  detalle="Escribí un mensaje para iniciar la conversación."
                />
              )}
            </div>
            {conectado && !puedeResponder && (
              <p className={styles.notice}>La cuenta de esta conversación está desconectada.</p>
            )}
            {puedeResponder && vencida && (
              <p className="m-2 small">
                La ventana de respuesta cerró. Esperá un nuevo mensaje del cliente.
              </p>
            )}
            <form className={chat.composer} onSubmit={enviar}>
              <label className="visually-hidden" htmlFor="message-text">
                Escribí un mensaje
              </label>
              <textarea
                id="message-text"
                rows={2}
                maxLength={maximo}
                value={texto}
                disabled={guardando || !puedeResponder || vencida}
                onChange={(event) => setTexto(event.target.value)}
                placeholder="Escribí un mensaje…"
              />
              <button
                type="submit"
                className={styles.button}
                disabled={!texto.trim() || guardando || !puedeResponder || vencida}
                aria-label={guardando ? 'Enviando mensaje' : 'Enviar mensaje'}
              >
                <PanelIcon nombre="enviar" size={18} />
              </button>
            </form>
          </div>
        ) : (
          <div className={chat.thread}>
            <EmptyState
              titulo="Elegí una conversación"
              detalle="Seleccioná un cliente para ver sus mensajes."
            />
          </div>
        )}
      </section>
    </>
  );
}
