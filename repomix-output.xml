  align-items: center;
  gap: 14px;
  font-size: 14px;
  color: #5f6c54;
}
.revenueRow strong {
  color: #46533c;
  text-align: right;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.revenueRow > span {
  text-transform: capitalize;
}
.revenueRow meter {
  appearance: none;
  width: 100%;
  height: 12px;
  border: 0;
  border-radius: 3px;
  background: #f0f2ec;
}
.revenueRow meter::-webkit-meter-bar {
  height: 12px;
  background: #f0f2ec;
  border: 0;
  border-radius: 3px;
}
.revenueRow meter::-webkit-meter-optimum-value {
  background: #b7c4a8;
  border-radius: 3px;
}
.revenueRow meter::-moz-meter-bar {
  background: #b7c4a8;
  border-radius: 3px;
}
.selected meter::-webkit-meter-optimum-value {
  background: #6d845b;
}
.selected meter::-moz-meter-bar {
  background: #6d845b;
}
.details {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 23px;
  margin: 28px 0;
  padding: 24px 0;
  border-block: 1px solid #e2e6dc;
}
.details dt {
  color: #5f6c54;
  font-weight: 400;
  font-size: 14px;
  line-height: 1.6;
}
.details dd {
  margin: 12px 0 0;
  font-size: 25px;
  font-weight: 500;
  color: #34432b;
  letter-spacing: -0.5px;
  font-variant-numeric: tabular-nums;
}
.appointments {
  padding: 6px 23px;
}
.appointments > div {
  display: grid;
  grid-template-columns: 1fr 35px 58px;
  align-items: center;
  gap: 15px;
  padding: 17px 0;
  border-bottom: 1px solid #ecefe7;
}
.appointments > div:last-child {
  border: 0;
}
.appointments strong {
  font-size: 15px;
  text-align: right;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.appointments > div > span:first-child {
  justify-self: start;
}
.appointments > div > span:last-child {
  text-align: right;
