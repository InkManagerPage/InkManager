<file path="Front/src/components/panel/PanelReminders.tsx">
'use client';

import { createContext, useContext, useState } from 'react';
import Offcanvas from 'react-bootstrap/Offcanvas';
import type { CitaPanel, ClientePanel } from '@/types/panel-artista';

import { PageHeader, PanelIcon } from './PanelUI';
import {
  describirRegla,
  diasSemana,
  recordatoriosArtista,
  recordatoriosCliente,
  reemplazarVariables,
  erroresReglaCorreo,
  variablesCorreo,
} from '@/lib/recordatorios';
import { fechaLocal, mostrarFecha, moverFecha } from '@/lib/panel-artista';
import type { RecordatoriosPanel, ReglaCorreo, TipoRecordatorio } from '@/types/recordatorios';
import styles from '@/components/panel/workspace.module.css';
import mail from './reminders.module.css';
import { useFormikContext } from 'formik';
import { PanelField, PanelForm } from './PanelForm';
import { useDiscardChanges } from '@/components/forms/UnsavedChanges';

const zonasHorarias = [
  ...new Set(['America/Argentina/Buenos_Aires', ...Intl.supportedValuesOf('timeZone')]),
];

export interface PanelRemindersProps {
  datos: { recordatorios: RecordatoriosPanel; citas: CitaPanel[]; consultas: unknown[] };
  nombre: string;
  buscarCliente: (id: string) => ClientePanel;
  guardarRecordatorios: (valor: RecordatoriosPanel) => Promise<string>;
  operacion: { puedeEditarClientes: boolean } | null;
  cargandoOperacion: boolean;
  errorOperacion: string;
  recargarOperacion: () => Promise<void>;
}
const ReminderContext = createContext<PanelRemindersProps | null>(null);
function useReminderPanel() {
  const value = useContext(ReminderContext);
  if (!value) throw new Error('Falta contexto de recordatorios.');
  return value;
}
export function PanelReminders(props: PanelRemindersProps) {
  return (
    <ReminderContext.Provider value={props}>
      <Reminders />
    </ReminderContext.Provider>
  );
}
function Reminders() {
  const {
    datos,
    guardarRecordatorios,
    operacion,
    cargandoOperacion,
    errorOperacion,
    recargarOperacion,
  } = useReminderPanel();
  const [editando, setEditando] = useState<TipoRecordatorio | null>(null);
  const [aviso, setAviso] = useState('');
  const [error, setError] = useState('');
  const [guardando, setGuardando] = useState(false);
  const config = datos.recordatorios;
  const confirmClose = useDiscardChanges();
  async function guardar(siguiente: RecordatoriosPanel) {
    setGuardando(true);
    setAviso('');
    const fallo = await guardarRecordatorios(siguiente);
    setGuardando(false);
    setError(fallo);
    if (!fallo) setAviso('Configuración de recordatorios actualizada.');
    return fallo;
  }
  const titulo = [...recordatoriosCliente, ...recordatoriosArtista].find(
    (item) => item.id === editando,
  )?.titulo;
  if (!operacion)
    return (
      <>
        <PageHeader titulo="Recordatorios" />
        {cargandoOperacion ? (
          <p role="status">Cargando recordatorios…</p>
        ) : (
          <p role="alert">
            {errorOperacion}{' '}
            <button className={styles.textButton} onClick={() => void recargarOperacion()}>
              Reintentar
            </button>
          </p>
        )}
      </>
    );
  return (
    <>
      <PageHeader
        titulo="Recordatorios"
        descripcion="Turnos, seguimiento y resúmenes de actividad."
      />
      {error && (
        <p className={`${styles.notice} ${styles.error}`} role="alert">
          {error}
        </p>
      )}
      {aviso && (
        <p className={styles.notice} role="status">
          {aviso}
        </p>
      )}
      {guardando && <p role="status">Guardando preferencias…</p>}
      <fieldset disabled={guardando}>
        <div className={mail.timezone}>
          <PanelIcon nombre="reloj" size={18} />
          <label htmlFor="reminder-timezone">Zona horaria</label>
          <select
            id="reminder-timezone"
            value={config.zonaHoraria}
            onChange={(event) => guardar({ ...config, zonaHoraria: event.target.value })}
          >
            {zonasHorarias.map((zona) => (
              <option value={zona} key={zona}>
                {zona.replaceAll('_', ' ')}
              </option>
            ))}
          </select>
        </div>
        <div className={styles.stack}>
          <section className={styles.surface} aria-labelledby="client-reminders">
            <div className={styles.surfaceHeading}>
              <div>
                <h2 id="client-reminders">Correos para tus clientes</h2>
                <p className={mail.groupDescription}>
                  Turnos, cuidados y seguimiento después de cada sesión.
                </p>
              </div>
              <label className={mail.groupSwitch}>
                <span>{config.clientesHabilitados ? 'Activados' : 'Desactivados'}</span>
                <span className="form-check form-switch m-0">
                  <input
                    className="form-check-input"
                    type="checkbox"
                    role="switch"
                    aria-label="Correos para clientes"
                    checked={config.clientesHabilitados}
                    disabled={!operacion.puedeEditarClientes}
                    onChange={(event) =>
                      guardar({ ...config, clientesHabilitados: event.target.checked })
                    }
                  />
                </span>
              </label>
            </div>
            {recordatoriosCliente.map((item) => (
              <ReminderRow
                key={item.id}
                titulo={item.titulo}
                descripcion={item.descripcion}
                tipo={item.id}
                regla={config.reglas[item.id]}
                habilitado={config.clientesHabilitados}
                editable={operacion.puedeEditarClientes}
                onToggle={() =>
                  guardar({
                    ...config,
                    reglas: {
                      ...config.reglas,
                      [item.id]: {
                        ...config.reglas[item.id],
                        activo: !config.reglas[item.id].activo,
                      },
                    },
                  })
                }
                onEdit={() => setEditando(item.id)}
              />
            ))}
            <div className={styles.sectionFoot}>
              <span>
                {operacion.puedeEditarClientes
                  ? 'Podés establecer excepciones desde la ficha del cliente o al editar un turno.'
                  : 'El titular del estudio administra estos correos.'}
              </span>
            </div>
          </section>
          <section className={styles.surface} aria-labelledby="artist-reminders">
            <div className={styles.surfaceHeading}>
              <div>
                <h2 id="artist-reminders">Correos para vos</h2>
                <p className={mail.groupDescription}>
                  Tu agenda y un resumen de cómo viene tu trabajo.
                </p>
              </div>
              <label className={mail.groupSwitch}>
                <span>{config.artistaHabilitado ? 'Activados' : 'Desactivados'}</span>
                <span className="form-check form-switch m-0">
                  <input
                    className="form-check-input"
                    type="checkbox"
                    role="switch"
                    aria-label="Correos para el artista"
                    checked={config.artistaHabilitado}
                    onChange={(event) =>
                      guardar({ ...config, artistaHabilitado: event.target.checked })
                    }
                  />
                </span>
              </label>
            </div>
            {recordatoriosArtista.map((item) => (
              <ReminderRow
                key={item.id}
                titulo={item.titulo}
                descripcion={item.descripcion}
                tipo={item.id}
                regla={config.reglas[item.id]}
                habilitado={config.artistaHabilitado}
                onToggle={() =>
                  guardar({
                    ...config,
                    reglas: {
                      ...config.reglas,
                      [item.id]: {
                        ...config.reglas[item.id],
                        activo: !config.reglas[item.id].activo,
                      },
                    },
                  })
                }
                onEdit={() => setEditando(item.id)}
              />
            ))}
          </section>
        </div>
      </fieldset>
      <Offcanvas
        show={Boolean(editando)}
        onHide={() => confirmClose(() => setEditando(null))}
        placement="end"
        className={styles.detailDrawer}
      >
        <Offcanvas.Header closeButton closeLabel="Cerrar">
          <Offcanvas.Title as="h2">{titulo}</Offcanvas.Title>
        </Offcanvas.Header>
        <Offcanvas.Body>
          {editando && (
            <ReminderEditor
              key={editando}
              tipo={editando}
              inicial={config.reglas[editando]}
              onCancel={() => confirmClose(() => setEditando(null))}
              onSave={async (regla) => {
                return guardar({
                  ...config,
                  reglas: { ...config.reglas, [editando]: regla },
                });
              }}
              onSaved={() => setEditando(null)}
            />
          )}
        </Offcanvas.Body>
      </Offcanvas>
    </>
  );
}

function ReminderRow({
  titulo,
  descripcion,
  tipo,
  regla,
  habilitado,
  editable = true,
  onToggle,
  onEdit,
}: {
  titulo: string;
  descripcion: string;
  tipo: TipoRecordatorio;
  regla: ReglaCorreo;
  habilitado: boolean;
  editable?: boolean;
  onToggle: () => void;
  onEdit: () => void;
}) {
  return (
    <div className={`${mail.ruleRow} ${!habilitado || !regla.activo ? mail.ruleDisabled : ''}`}>
      <div className={mail.ruleIcon}>
        <PanelIcon
          nombre={
            tipo === 'AGENDA' || tipo === 'TURNO'
              ? 'agenda'
              : tipo.startsWith('RESUMEN')
                ? 'resumen'
                : 'mensajes'
          }
        />
      </div>
      <div className={mail.ruleContent}>
        <h3>{titulo}</h3>
        <p>{descripcion}</p>
        <span className={mail.schedule}>
          <PanelIcon nombre="reloj" size={13} />
          {describirRegla(tipo, regla)}
        </span>
      </div>
      <div className={mail.ruleActions}>
        <button
          className={styles.textButton}
          onClick={onEdit}
          disabled={!editable}
          aria-label={`Configurar ${titulo}`}
        >
          Configurar
        </button>
        <label className={`form-check form-switch m-0 ${mail.switchTarget}`}>
          <input
            className="form-check-input"
            type="checkbox"
            role="switch"
            aria-label={titulo}
            checked={regla.activo && habilitado}
            disabled={!habilitado || !editable}
            onChange={onToggle}
          />
        </label>
      </div>
    </div>
  );
}

function ReminderEditor({
  tipo,
  inicial,
  onSave,
  onSaved,
  onCancel,
}: {
  tipo: TipoRecordatorio;
  inicial: ReglaCorreo;
  onSave: (regla: ReglaCorreo) => Promise<string>;
  onSaved: () => void;
  onCancel: () => void;
}) {
  return (
    <PanelForm<ReglaCorreo>
      initialValues={inicial}
      validate={(values) => erroresReglaCorreo(tipo, values)}
      onSave={(regla) =>
        onSave({ ...regla, asunto: regla.asunto.trim(), mensaje: regla.mensaje.trim() })
      }
      onSaved={onSaved}
    >
      <ReminderFields tipo={tipo} onCancel={onCancel} />
    </PanelForm>
  );
}

function ReminderFields({ tipo, onCancel }: { tipo: TipoRecordatorio; onCancel: () => void }) {
  const { values: regla, setFieldValue, isSubmitting } = useFormikContext<ReglaCorreo>();
  const { datos, buscarCliente, nombre } = useReminderPanel();

  const hoy = fechaLocal(new Date());
  const proxima = datos.citas
    .filter((cita) => cita.fecha >= hoy && !['CANCELADA', 'COMPLETADA'].includes(cita.estado))
    .sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora))[0];
  const valores = {
    cliente: proxima ? buscarCliente(proxima.clienteId).nombre : 'Sofía Aguirre',
    artista: nombre,
    fecha: mostrarFecha(proxima?.fecha || moverFecha(hoy, 1), { day: 'numeric', month: 'long' }),
    hora: proxima?.hora || '14:00',
    trabajo: proxima?.titulo || 'tu tatuaje',
    agenda: datos.citas
      .filter((cita) => cita.fecha === (proxima?.fecha || hoy) && cita.estado !== 'CANCELADA')
      .map((cita) => `${cita.hora} · ${buscarCliente(cita.clienteId).nombre} · ${cita.titulo}`)
      .join('\n'),
    resumen: `${datos.consultas.length} consultas recibidas\n${datos.citas.filter((cita) => cita.estado === 'COMPLETADA').length} sesiones completadas`,
  };
  return (
    <fieldset disabled={isSubmitting}>
      {['TURNO', 'CUIDADOS'].includes(tipo) && (
        <PanelField
          name="horas"
          label={
            tipo === 'TURNO' ? 'Horas antes del turno' : 'Horas después de completar la sesión'
          }
          type="number"
          required
          min={tipo === 'TURNO' ? 1 : 0}
          max={168}
        />
      )}
      {tipo === 'RESENA' && (
        <PanelField
          name="dias"
          label="Días después de completar la sesión"
          type="number"
          required
          min={1}
          max={30}
        />
      )}
      {tipo === 'AGENDA' && (
        <PanelField name="momentoAgenda" label="Cuándo recibirla" as="select">
          <option value="ANTERIOR">La noche anterior</option>
          <option value="MISMO_DIA">El mismo día</option>
        </PanelField>
      )}
      {tipo === 'RESUMEN_SEMANAL' && (
        <PanelField name="diaSemana" label="Día de envío" as="select" type="number">
          {diasSemana.map((dia, indice) => (
            <option key={dia} value={indice}>
              {dia}
            </option>
          ))}
        </PanelField>
      )}
      {['AGENDA', 'RESUMEN_SEMANAL', 'RESUMEN_MENSUAL'].includes(tipo) && (
        <PanelField
          name="hora"
          label="Horario de envío"
          type="time"
          required
          hint={
            tipo === 'RESUMEN_MENSUAL' ? 'Día 1, con la actividad del mes anterior.' : undefined
          }
        />
      )}
      <PanelField name="asunto" label="Asunto" required minLength={3} maxLength={120} />
      <PanelField
        name="mensaje"
        label="Contenido del correo"
        as="textarea"
        rows={9}
        required
        minLength={10}
        maxLength={3000}
        hint={`${regla.mensaje.length}/3000 caracteres`}
      />
      <div className={mail.variables}>
        <span>Insertar variable</span>
        <div>
          {variablesCorreo(tipo).map((variable) => (
            <button
              type="button"
              key={variable}
              onClick={() => {
                void setFieldValue('mensaje', regla.mensaje + ' {{' + variable + '}}');
              }}
            >
              {'{{' + variable + '}}'}
            </button>
          ))}
        </div>
      </div>
      <details className={mail.emailDetails}>
        <summary>
          Ver correo <PanelIcon nombre="chevron" size={14} />
        </summary>
        <article className={mail.email}>
          <header>
            <span>InkManager</span>
            <strong>{reemplazarVariables(regla.asunto, valores)}</strong>
            <small>
              Para:{' '}
              {['TURNO', 'CUIDADOS', 'RESENA'].includes(tipo) ? valores.cliente : valores.artista}
            </small>
          </header>
          <div>{reemplazarVariables(regla.mensaje, valores)}</div>
        </article>
      </details>
      <div className={styles.formActions}>
        <button className={styles.secondaryButton} type="button" onClick={onCancel}>
          Cancelar
        </button>
        <button className={styles.button} type="submit">
          Guardar recordatorio
        </button>
      </div>
    </fieldset>
  );
}
</file>

<file path="Front/src/components/panel/TeamWorkspace.tsx">
'use client';
import { Suspense, useState, useRef } from 'react';
import Link from 'next/link';
import Modal from 'react-bootstrap/Modal';
import Dropdown from 'react-bootstrap/Dropdown';
import { useAuth } from '@/store/AuthProvider';
import { useConsultas } from '@/hooks/useConsultas';
import { usePanelFilters } from '@/hooks/usePanelFilters';
import { useDiscardChanges } from '@/components/forms/UnsavedChanges';
import { PageHeader, EmptyState, Avatar, SearchField } from './PanelUI';
import { PanelForm, PanelField } from './PanelForm';
import { InvitationList, type AccionInvitacion } from './InvitationList';
import {
  invitarArtista,
  cambiarIntegrante,
  gestionarInvitacion,
  responderInvitacion,
} from '@/services/equipo.service';
import { solicitarCorreoCuenta } from '@/services/auth.service';
import { cantidad } from '@/lib/panel-artista';
import type { IntegranteGuardado, AccionIntegrante, InvitacionEquipo } from '@/types/equipo';
import styles from './workspace.module.css';

type Confirmacion =
  | { tipo: 'INTEGRANTE'; artista: IntegranteGuardado; accion: AccionIntegrante }
  | { tipo: 'INVITACION'; invitacion: InvitacionEquipo; accion: AccionInvitacion };
export function TeamWorkspace() {
  return (
    <Suspense fallback={<p role="status">Cargando equipo…</p>}>
      <Team />
    </Suspense>
  );
}
function Team() {
  const { datos, cargando, error, recargar, actualizarEquipo } = useConsultas();
  const { usuario, reintentar } = useAuth(),
    { params, update } = usePanelFilters(),
    descartar = useDiscardChanges();
  const [invitar, setInvitar] = useState(false),
    [aviso, setAviso] = useState(''),
    [confirmacion, setConfirmacion] = useState<Confirmacion | null>(null);
  const resultado = useRef('');
  const titular = usuario?.rol === 'ESTUDIO_ADMIN',
    base = titular ? '/estudio' : '/artista';
  const filtro = params.get('estado') || '',
    busqueda = params.get('buscar') || '',
    artista = params.get('artista');
  const equipo = (datos?.equipo || []).filter(
    (a) =>
      (!filtro || a.estado === filtro) &&
      (!artista || a.id === artista) &&
      `${a.nombre} ${a.email} ${a.estilos}`
        .toLocaleLowerCase('es')
        .includes(busqueda.toLocaleLowerCase('es')),
  );
  async function ejecutar() {
    if (!confirmacion) return;
    if (confirmacion.tipo === 'INTEGRANTE')
      resultado.current = await cambiarIntegrante(
        confirmacion.artista.id,
        confirmacion.accion,
        confirmacion.artista.version,
      );
    else {
      const { invitacion: i, accion } = confirmacion;
      resultado.current = await (accion === 'ACEPTAR' || accion === 'RECHAZAR'
        ? responderInvitacion(i.id, accion, i.version)
        : gestionarInvitacion(i.id, accion, i.version));
    }
    await actualizarEquipo();
  }
  return (
    <>
      <PageHeader
        titulo={titular ? 'Equipo' : 'Mi estudio'}
        descripcion={
          datos?.contexto.tipo === 'ESTUDIO' ? datos.contexto.nombre : 'Artista independiente'
        }
      >
        <button
          className={styles.secondaryButton}
          onClick={() => {
            void recargar();
          }}
        >
          Actualizar
        </button>
        {titular && (
          <button
            className={styles.button}
            disabled={!datos?.contexto.emailVerificado}
            onClick={() => setInvitar(true)}
          >
            Invitar artista
          </button>
        )}
      </PageHeader>
      {error && (
        <p role="alert" className="alert alert-danger">
          {error}
        </p>
      )}
      {aviso && (
        <p role="status" className={styles.notice}>
          {aviso}
        </p>
      )}
      {datos && !datos.contexto.emailVerificado && (
        <div className={styles.notice}>
          <p>Verificá tu email para {titular ? 'enviar' : 'ver y responder'} invitaciones.</p>
          <button
            className={styles.textButton}
            onClick={() => {
              void solicitarCorreoCuenta(usuario!.email, true)
                .then(setAviso)
                .catch((e) =>
                  setAviso(e instanceof Error ? e.message : 'No pudimos enviar el correo.'),
                );
            }}
          >
            Enviar correo de verificación
          </button>
        </div>
      )}
      {cargando && !datos ? (
        <p role="status">Cargando equipo…</p>
      ) : (
        datos && (
          <>
            {datos.contexto.tipo === 'ESTUDIO' ? (
              <>
                <div className={styles.toolbar}>
                  <div className={styles.tabs}>
                    {[
                      ['', 'Todos'],
                      ['ACTIVO', 'Activos'],
                      ['SUSPENDIDO', 'Suspendidos'],
                    ].map(([key, label]) => (
                      <button
                        key={key}
                        className={filtro === key ? styles.tabActive : ''}
                        aria-pressed={filtro === key}
                        onClick={() => update({ estado: key || null })}
                      >
                        {label}
                      </button>
                    ))}
                  </div>
                  <SearchField
                    placeholder="Buscar artista"
                    value={busqueda}
                    onChange={(v) => update({ buscar: v || null })}
                  />
                </div>
                {artista && (
                  <button className={styles.textButton} onClick={() => update({ artista: null })}>
                    Ver todo el equipo
                  </button>
                )}
                <section className={styles.surface} aria-label="Integrantes del estudio">
                  {equipo.length ? (
                    equipo.map((a) => (
                      <article className={styles.mobileItem} key={a.id}>
                        <div className={styles.mobileItemHeader}>
                          <div className={styles.identity}>
                            <Avatar nombre={a.nombre} />
                            <div>
                              <strong>
                                {a.nombre}
                                {a.id === usuario?.id ? ' · vos' : ''}
                              </strong>
                              <small>{a.estilos}</small>
                            </div>
                          </div>
                          <span className={styles.status}>
                            {a.estado === 'ACTIVO' ? 'Activo' : 'Suspendido'}
                          </span>
                        </div>
                        {a.email && <p>{a.email}</p>}
                        <div className={styles.headerActions}>
                          <Link
                            className={styles.textButton}
                            href={`${base}/consultas?artista=${a.id}`}
                          >
                            Ver consultas
                          </Link>
                          {titular && (
                            <Link
                              className={styles.textButton}
                              href={`${base}/agenda?artista=${a.id}&rango=todos&vista=LISTA&canceladas=1`}
                            >
                              {cantidad(a.turnosPendientes, 'turno')} pendiente
                              {a.turnosPendientes === 1 ? '' : 's'}
                            </Link>
                          )}
                          {titular && (
                            <Link
                              className={styles.textButton}
                              href={`/estudio/disponibilidad?artista=${a.id}`}
                            >
                              Horarios y bloqueos
                            </Link>
                          )}
                          {titular && (
                            <Dropdown>
                              <Dropdown.Toggle
                                variant="outline-dark"
                                size="sm"
                                aria-label={`Administrar a ${a.nombre}`}
                              >
                                Administrar
                              </Dropdown.Toggle>
                              <Dropdown.Menu align="end">
                                <Dropdown.Item
                                  onClick={() =>
                                    setConfirmacion({
                                      tipo: 'INTEGRANTE',
                                      artista: a,
                                      accion: a.estado === 'ACTIVO' ? 'SUSPENDER' : 'HABILITAR',
                                    })
                                  }
                                >
                                  {a.estado === 'ACTIVO' ? 'Suspender' : 'Habilitar'}
                                </Dropdown.Item>
                                <Dropdown.Divider />
                                <Dropdown.Item
                                  className="text-danger"
                                  onClick={() =>
                                    setConfirmacion({
                                      tipo: 'INTEGRANTE',
                                      artista: a,
                                      accion: 'DESVINCULAR',
                                    })
                                  }
                                >
                                  Desvincular del estudio
                                </Dropdown.Item>
                              </Dropdown.Menu>
                            </Dropdown>
                          )}
                        </div>
                      </article>
                    ))
                  ) : (
                    <EmptyState
                      titulo={
                        datos.equipo.length
                          ? 'No hay artistas con esos filtros'
                          : 'Todavía no hay artistas en el equipo'
                      }
                    />
                  )}
                </section>
              </>
            ) : (
              <section className={styles.surface}>
                <EmptyState titulo="Trabajás de forma independiente" />
              </section>
            )}
            <InvitationList
              invitaciones={datos.invitaciones || []}
              titular={titular}
              puedeAceptar={
                datos.contexto.tipo === 'INDEPENDIENTE' && datos.contexto.emailVerificado
              }
              onAction={(i, a) => setConfirmacion({ tipo: 'INVITACION', invitacion: i, accion: a })}
            />
          </>
        )
      )}
      <Modal show={invitar} onHide={() => descartar(() => setInvitar(false))} centered>
        <Modal.Header closeButton closeLabel="Cerrar">
          <Modal.Title as="h2" className="fs-5">
            Invitar artista
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {invitar && (
            <PanelForm
              initialValues={{ email: '' }}
              validate={(v) =>
                !v.email.trim() ||
                v.email.length > 254 ||
                !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email.trim())
                  ? { email: 'Ingresá un email válido.' }
                  : {}
              }
              onSave={async (v) => {
                resultado.current = await invitarArtista(v.email);
                await actualizarEquipo();
              }}
              onSaved={() => {
                setInvitar(false);
                setAviso(resultado.current);
              }}
            >
              <PanelField
                name="email"
                label="Email del artista"
                type="email"
                required
                maxLength={254}
                autoComplete="email"
              />
              <p className={styles.muted}>
                La invitación vence en 7 días. El artista debe aceptarla con una cuenta registrada
                con este email.
              </p>
              <div className={styles.formActions}>
                <button
                  type="button"
                  className={styles.secondaryButton}
                  onClick={() => descartar(() => setInvitar(false))}
                >
                  Volver
                </button>
                <button type="submit" className={styles.button}>
                  Enviar invitación
                </button>
              </div>
            </PanelForm>
          )}
        </Modal.Body>
      </Modal>
      <Modal show={Boolean(confirmacion)} onHide={() => setConfirmacion(null)} centered>
        <Modal.Header closeButton closeLabel="Cerrar">
          <Modal.Title as="h2" className="fs-5">
            {tituloConfirmacion(confirmacion)}
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {confirmacion && (
            <PanelForm
              key={
                confirmacion.tipo === 'INTEGRANTE'
                  ? confirmacion.artista.id + confirmacion.accion
                  : confirmacion.invitacion.id + confirmacion.accion
              }
              initialValues={{}}
              validate={() => ({})}
              onSave={ejecutar}
              onSaved={() => {
                const acepta =
                  confirmacion.tipo === 'INVITACION' && confirmacion.accion === 'ACEPTAR';
                setConfirmacion(null);
                setAviso(resultado.current);
                if (acepta) reintentar();
              }}
            >
              <ConfirmationContent valor={confirmacion} base={base} />
              <div className={styles.formActions}>
                <button
                  type="button"
                  className={styles.secondaryButton}
                  onClick={() => setConfirmacion(null)}
                >
                  Volver
                </button>
                <button
                  type="submit"
                  className={styles.button}
                  disabled={
                    confirmacion.tipo === 'INTEGRANTE' &&
                    confirmacion.accion === 'DESVINCULAR' &&
                    Boolean(
                      confirmacion.artista.turnosPendientes ||
                      confirmacion.artista.consultasAsignadas,
                    )
                  }
                >
                  {confirmacion.tipo === 'INTEGRANTE'
                    ? {
                        SUSPENDER: 'Suspender artista',
                        HABILITAR: 'Habilitar artista',
                        DESVINCULAR: 'Desvincular artista',
                      }[confirmacion.accion]
                    : {
                        ACEPTAR: 'Aceptar y unirme',
                        RECHAZAR: 'Rechazar invitación',
                        CANCELAR: 'Cancelar invitación',
                        REENVIAR: 'Reenviar invitación',
                      }[confirmacion.accion]}
                </button>
              </div>
            </PanelForm>
          )}
        </Modal.Body>
      </Modal>
    </>
  );
}
function tituloConfirmacion(v: Confirmacion | null) {
  if (!v) return '';
  return v.tipo === 'INTEGRANTE'
    ? `${{ SUSPENDER: 'Suspender', HABILITAR: 'Habilitar', DESVINCULAR: 'Desvincular' }[v.accion]} a ${v.artista.nombre}`
    : v.accion === 'ACEPTAR'
      ? `Sumarte a ${v.invitacion.estudioNombre}`
      : {
          RECHAZAR: 'Rechazar invitación',
          CANCELAR: 'Cancelar invitación',
          REENVIAR: 'Reenviar invitación',
        }[v.accion];
}
function ConfirmationContent({ valor: v, base }: { valor: Confirmacion; base: string }) {
  if (v.tipo === 'INVITACION')
    return (
      <p>
        {v.accion === 'ACEPTAR'
          ? 'Vas a trabajar como integrante del estudio. Tu perfil y tus trabajos siguen siendo tuyos. Primero debés tener resueltas tus consultas y sesiones independientes.'
          : v.accion === 'REENVIAR'
            ? `Se enviará nuevamente la invitación a ${v.invitacion.email}.`
            : 'Esta invitación dejará de estar disponible.'}
      </p>
    );
  const a = v.artista;
  if (v.accion === 'SUSPENDER')
    return (
      <p>
        El artista podrá consultar sus turnos y proyectos asignados, pero no cotizar ni
        modificarlos. Sus turnos y consultas se conservan.
      </p>
    );
  if (v.accion === 'HABILITAR')
    return <p>El artista podrá volver a presentar propuestas y gestionar sus turnos.</p>;
  return (
    <>
      <p>
        Se quitará su acceso al estudio. Su cuenta y portafolio se conservan, al igual que el
        historial del estudio.
      </p>
      {Boolean(a.turnosPendientes || a.consultasAsignadas) && (
        <div className={styles.notice}>
          <p>Primero resolvé los turnos pendientes y reasigná o archivá sus consultas.</p>
          <p>
            <Link href={`${base}/agenda?artista=${a.id}&rango=todos&vista=LISTA`}>
              {cantidad(a.turnosPendientes, 'turno')} pendiente{a.turnosPendientes === 1 ? '' : 's'}
            </Link>
          </p>
          <Link href={`${base}/consultas?artista=${a.id}`}>
            {cantidad(a.consultasAsignadas, 'consulta')} asignada
            {a.consultasAsignadas === 1 ? '' : 's'}
          </Link>
        </div>
      )}
    </>
  );
}
</file>

