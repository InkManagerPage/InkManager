        </Link>
        <GoogleButton onClick={iniciarLoginGoogle}>Continuar con Google</GoogleButton>
        <p className={styles.switch}>
          ¿Todavía no tenés cuenta?{' '}
          <button type="button" onClick={onSwitch}>
