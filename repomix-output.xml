  overflow-y: auto;
  padding: 10px 28px 25px;
  overscroll-behavior: contain;
}
.dateSeparator {
  margin: 20px 0;
  text-align: center;
  font-size: 12px;
  color: #5f6c54;
}
.message {
  width: fit-content;
  max-width: 83%;
  padding: 14px 17px 9px;
  margin: 0 0 14px;
  border: 1px solid #e5ebdb;
  border-radius: 8px 8px 8px 2px;
  background: #fff;
}
.message p {
  margin: 0;
  line-height: 1.7;
  font-size: 14px;
  color: #697a59;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.message time {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 5px;
  margin-top: 7px;
  font-size: 11px;
  color: #5f6c54;
}
.outgoing {
  margin-left: auto;
  background: #edf3e3;
  border-color: #e5ecd8;
  border-radius: 8px 8px 2px 8px;
}
.composer {
  display: flex;
  align-items: flex-end;
  gap: 12px;
  padding: 15px 20px;
  background: #fff;
  border-top: 1px solid #e6edda;
}
.composer textarea {
  flex: 1;
  min-width: 0;
  max-height: 130px;
  resize: vertical;
  border: 0;
  padding: 5px 0;
  outline: none;
  font-size: 14px;
  line-height: 1.6;
  color: #6c7d5a;
}
.composer textarea:focus-visible {
  outline: 2px solid #e5ecd9;
  outline-offset: 4px;
}
.composer button {
  min-width: 42px;
  padding: 10px;
}

.back {
  display: none;
}
@media (max-width: 1150px) {
  .messenger {
    grid-template-columns: 260px minmax(0, 1fr);
  }
}
@media (max-width: 650px) {
  .messenger {
    display: block;
    height: calc(100dvh - 220px);
    min-height: 450px;
  }
  .conversations {
    height: 100%;
    border: 0;
  }
  .thread {
    display: none;
    height: 100%;
  }
  .mobileThread .conversations {
    display: none;
  }
  .mobileThread .thread {
    display: flex;
  }
  .back {
    display: inline-flex;
  }
  .messages {
    padding: 5px 16px 18px;
  }
  .message {
    max-width: 92%;
  }
  .composer {
    padding: 13px 16px;
  }
  .threadHeader {
    padding: 15px 16px;
  }
}
</file>

<file path="Front/src/components/panel/NotificacionesPanel.tsx">
'use client';

import { usePanelFilters } from '@/hooks/usePanelFilters';
import Link from 'next/link';
import type { NotificacionPanel } from '@/types/panel-artista';
import { EmptyState, PageHeader, PanelIcon } from './PanelUI';
import { mostrarFecha } from '@/lib/panel-artista';
import styles from '@/components/panel/workspace.module.css';

export function NotificacionesPanel({
  avisos,
  leerNotificacion,
  cargandoOperacion,
  errorOperacion,
}: {
  avisos: NotificacionPanel[];
  leerNotificacion: (id?: string) => Promise<void>;
  cargandoOperacion: boolean;
  errorOperacion: string;
}) {
  const { params, update } = usePanelFilters();
  const soloNuevas = params.get('sinLeer') === '1';
  const setSoloNuevas = (value: boolean) => update({ sinLeer: value ? '1' : null });
  const pendientes = avisos.filter((item) => !item.leida).length;
  const visibles = avisos
    .filter((item) => !soloNuevas || !item.leida)
    .sort((a, b) => b.fecha.localeCompare(a.fecha));
  return (
    <>
      <PageHeader
        titulo="Notificaciones"
        descripcion="Novedades de tus consultas, sesiones y equipo."
      >
        <button
          className={styles.secondaryButton}
          onClick={() => leerNotificacion()}
          disabled={!pendientes}
        >
          <PanelIcon nombre="check" size={17} />
          Marcar todas como leídas
        </button>
      </PageHeader>
      {errorOperacion && (
        <p className="alert alert-danger" role="alert">
          {errorOperacion}
        </p>
      )}
      {cargandoOperacion && <p role="status">Cargando notificaciones…</p>}
      <div className={styles.toolbar}>
        <div className={styles.tabs}>
          <button
            aria-pressed={!soloNuevas}
            className={!soloNuevas ? styles.tabActive : ''}
            onClick={() => setSoloNuevas(false)}
          >
            Todas<span>{avisos.length}</span>
          </button>
          <button
            aria-pressed={soloNuevas}
            className={soloNuevas ? styles.tabActive : ''}
            onClick={() => setSoloNuevas(true)}
          >
            Sin leer<span>{pendientes}</span>
          </button>
        </div>
      </div>
      <section className={styles.surface} aria-label="Notificaciones">
        {visibles.length
          ? visibles.map((item) => (
              <article
                className={`${styles.notification} ${!item.leida ? styles.unread : ''}`}
                key={item.id}
              >
                <span className={styles.avatar}>
                  <PanelIcon nombre="campana" size={18} />
                </span>
                <div>
                  <h2>
                    {item.titulo}
                    {!item.leida && <span className={styles.unreadMark} aria-label="Sin leer" />}
                  </h2>
                  <p>{item.detalle}</p>
                  <div className={styles.headerActions}>
                    <Link
                      href={item.destino}
                      onClick={() => leerNotificacion(item.id)}
                      className={styles.textButton}
                    >
                      Ver detalle
                      <PanelIcon nombre="flecha" size={15} />
                    </Link>
                    {!item.leida && (
                      <button
                        className={styles.textButton}
                        onClick={() => leerNotificacion(item.id)}
                      >
                        Marcar como leída
                      </button>
                    )}
                  </div>
                </div>
                <time dateTime={item.fecha}>
                  {mostrarFecha(item.fecha, {
                    day: 'numeric',
                    month: 'short',
                    hour: '2-digit',
                    minute: '2-digit',
                  })}
                </time>
              </article>
            ))
          : !cargandoOperacion && (
              <EmptyState titulo="Estás al día" detalle="No tenés notificaciones pendientes." />
            )}
      </section>
    </>
  );
}
</file>

<file path="Front/src/components/panel/PanelClients.tsx">
'use client';

import { createContext, useContext, useState } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { usePanelFilters } from '@/hooks/usePanelFilters';
import { useDiscardChanges, useUnsavedChanges } from '@/components/forms/UnsavedChanges';
import { PanelField, PanelForm } from './PanelForm';
import Modal from 'react-bootstrap/Modal';
import Offcanvas from 'react-bootstrap/Offcanvas';
import type { CitaPanel } from '@/types/panel-artista';
import type { ExcepcionesRecordatorios, RecordatoriosPanel } from '@/types/recordatorios';
import { Avatar, EmptyState, PageHeader, PanelIcon, SearchField } from './PanelUI';
import { cantidad, erroresCliente, fechaLocal, moneda, mostrarFecha } from '@/lib/panel-artista';
import type { ClientePanel } from '@/types/panel-artista';
import { ciudadesEjemplo } from '@/mocks/panel-artista';
import { PanelReminderOverrides } from './PanelReminderOverrides';
import styles from '@/components/panel/workspace.module.css';

export interface PanelClientsProps {
  baseRuta: string;
  datos: {
    clientes: ClientePanel[];
    citas: CitaPanel[];
    consultas: { id: string; clienteId: string; titulo: string }[];
    recordatorios: RecordatoriosPanel;
  };
  guardarCliente: (cliente: Omit<ClientePanel, 'id'>, id?: string) => string;
  abrirConversacion: (id: string) => string;
  guardarExcepcionesCliente: (id: string, valor: ExcepcionesRecordatorios) => void;
}
const ClientContext = createContext<PanelClientsProps | null>(null);
function useClientPanel() {
  const value = useContext(ClientContext);
  if (!value) throw new Error('Falta contexto de clientes.');
  return value;
}
export function PanelClients(props: PanelClientsProps) {
  return (
    <ClientContext.Provider value={props}>
      <Clients />
    </ClientContext.Provider>
  );
}
function Clients() {
  const { datos } = useClientPanel();
  const { params, update } = usePanelFilters();
  const confirmClose = useDiscardChanges();
  const busqueda = params.get('q') || '';
  const setBusqueda = (value: string) => update({ q: value || null }, true);
  const [formulario, setFormulario] = useState<{ cliente?: ClientePanel } | null>(null);
  const [aviso, setAviso] = useState('');
  const seleccionada = datos.clientes.find((cliente) => cliente.id === params.get('cliente'));
  const clientes = datos.clientes
    .filter((cliente) =>
      `${cliente.nombre} ${cliente.email} ${cliente.ciudad}`
        .toLocaleLowerCase('es')
        .includes(busqueda.toLocaleLowerCase('es')),
    )
    .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
  function proximoTurno(clienteId: string) {
    const cita = datos.citas
      .filter(
        (cita) =>
          cita.clienteId === clienteId &&
          cita.fecha >= fechaLocal(new Date()) &&
          !['CANCELADA', 'COMPLETADA'].includes(cita.estado),
      )
      .sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora))[0];
    return cita ? mostrarFecha(cita.fecha) + ' · ' + cita.hora : 'Sin agendar';
  }
  function abrir(id?: string) {
    update({ cliente: id || null, editar: null });
  }
  return (
    <>
      <PageHeader
        titulo="Clientes"
        descripcion="Contactos, proyectos y sesiones en un mismo lugar."
      >
        <button className={styles.button} onClick={() => setFormulario({})}>
          <PanelIcon nombre="mas" size={17} />
          Agregar cliente
        </button>
      </PageHeader>
      {aviso && (
        <p className={styles.notice} role="status">
          {aviso}
        </p>
      )}
      <div className={styles.toolbar}>
        <span className={styles.muted}>{cantidad(datos.clientes.length, 'cliente')}</span>
        <SearchField
          value={busqueda}
          onChange={setBusqueda}
          placeholder="Buscar nombre, email o ciudad"
        />
      </div>
      <section className={styles.surface} aria-label="Clientes">
        {clientes.length ? (
          <>
            <div className={styles.mobileList}>
              {clientes.map((cliente) => (
                <article className={styles.mobileItem} key={cliente.id}>
                  <button onClick={() => abrir(cliente.id)}>
                    <div className={styles.mobileItemHeader}>
                      <strong>{cliente.nombre}</strong>
                      <PanelIcon nombre="chevron" size={18} />
                    </div>
                    <p>{cliente.email}</p>
                    <small>{cliente.ciudad || 'Sin ubicación'}</small>
                    <p>Próximo turno: {proximoTurno(cliente.id)}</p>
                  </button>
                </article>
              ))}
            </div>
            <div className={`${styles.tableScroll} ${styles.desktopList}`}>
              <table className={styles.table}>
                <thead>
                  <tr>
                    <th>Cliente</th>
                    <th>Ubicación</th>
                    <th>Sesiones</th>
                    <th>Próxima sesión</th>
                    <th>
                      <span className="visually-hidden">Abrir ficha</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {clientes.map((cliente) => {
                    const citas = datos.citas.filter(
                      (cita) => cita.clienteId === cliente.id && cita.estado !== 'CANCELADA',
                    );
                    const proxima = citas
                      .filter(
                        (cita) =>
                          cita.fecha >= fechaLocal(new Date()) && cita.estado !== 'COMPLETADA',
                      )
                      .sort((a, b) =>
                        `${a.fecha}${a.hora}`.localeCompare(`${b.fecha}${b.hora}`),
                      )[0];
                    return (
                      <tr key={cliente.id}>
                        <td>
                          <button
                            onClick={() => abrir(cliente.id)}
                            className={`${styles.identity} ${styles.rowLink}`}
                          >
                            <Avatar nombre={cliente.nombre} />
                            <span>
                              <strong>{cliente.nombre}</strong>
                              <small>{cliente.email}</small>
                            </span>
                          </button>
                        </td>
                        <td className={styles.muted}>{cliente.ciudad || 'Sin indicar'}</td>
                        <td className={styles.muted}>
                          {cantidad(
                            citas.filter((cita) => cita.estado === 'COMPLETADA').length,
                            'completada',
                          )}
                        </td>
                        <td className={styles.muted}>
                          {proxima
                            ? `${mostrarFecha(proxima.fecha)} · ${proxima.hora}`
                            : 'Sin agendar'}
                        </td>
                        <td>
                          <button
                            className={styles.textButton}
                            onClick={() => abrir(cliente.id)}
                            aria-label={`Ver ficha de ${cliente.nombre}`}
                          >
                            <PanelIcon nombre="chevron" size={17} />
                          </button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <EmptyState
            titulo={
              datos.clientes.length ? 'No encontramos ese cliente' : 'Todavía no tenés clientes'
            }
            detalle={
              datos.clientes.length
                ? 'Probá otro nombre, email o ciudad.'
                : 'Agregá tu primer contacto para coordinar un turno.'
            }
          />
        )}
      </section>
      <Offcanvas
        show={Boolean(seleccionada)}
        onHide={() => abrir()}
        placement="end"
        className={styles.detailDrawer}
      >
        <Offcanvas.Header closeButton closeLabel="Cerrar">
          <Offcanvas.Title as="h2">Ficha del cliente</Offcanvas.Title>
        </Offcanvas.Header>
        <Offcanvas.Body>
          {seleccionada &&
            (params.get('editar') === '1' ? (
              <ClientForm
                key={seleccionada.id}
                cliente={seleccionada}
                onCancel={() => update({ editar: null }, true)}
                onSaved={() => {
                  update({ editar: null }, true);
                  setAviso('Cliente guardado.');
                }}
              />
            ) : (
              <ClientDetail
                key={seleccionada.id}
                cliente={seleccionada}
                onEdit={() => update({ editar: '1' })}
              />
            ))}
        </Offcanvas.Body>
      </Offcanvas>
      <Modal
        show={Boolean(formulario && !formulario.cliente)}
        onHide={() => confirmClose(() => setFormulario(null))}
        centered
        scrollable
        fullscreen="sm-down"
        className="artist-dialog"
      >
        <Modal.Header closeButton closeLabel="Cerrar">
          <Modal.Title as="h2" className="fs-5">
            {formulario?.cliente ? 'Editar cliente' : 'Agregar cliente'}
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {formulario && (
            <ClientForm
              key={formulario.cliente?.id || 'nuevo'}
              cliente={formulario.cliente}
              onCancel={() => confirmClose(() => setFormulario(null))}
              onSaved={() => {
                setFormulario(null);
                setAviso('Cliente guardado.');
              }}
            />
          )}
        </Modal.Body>
      </Modal>
    </>
  );
}

function ClientDetail({ cliente, onEdit }: { cliente: ClientePanel; onEdit: () => void }) {
  const { datos, guardarCliente, abrirConversacion, guardarExcepcionesCliente, baseRuta } =
    useClientPanel();
  const router = useRouter();
  const [notas, setNotas] = useState(cliente.notas);
  const clearPendingNotes = useUnsavedChanges(notas.trim() !== cliente.notas);
  const confirmClose = useDiscardChanges();
  const [aviso, setAviso] = useState('');
  const citas = datos.citas
    .filter((item) => item.clienteId === cliente.id)
    .sort((a, b) => `${b.fecha}${b.hora}`.localeCompare(`${a.fecha}${a.hora}`));
  const consultas = datos.consultas.filter((item) => item.clienteId === cliente.id);
  return (
    <>
      <div className={styles.detailHeader}>
        <Avatar nombre={cliente.nombre} grande />
        <button className={styles.textButton} onClick={onEdit}>
          Editar datos
        </button>
      </div>
      <h2 className={styles.detailTitle}>{cliente.nombre}</h2>
      <dl className={styles.facts}>
        <div>
          <dt>Email</dt>
          <dd>{cliente.email}</dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd>{cliente.telefono || 'Sin indicar'}</dd>
        </div>
        <div>
          <dt>Ubicación</dt>
          <dd>{cliente.ciudad || 'Sin indicar'}</dd>
        </div>
        <div>
          <dt>Sesiones completadas</dt>
          <dd>{citas.filter((item) => item.estado === 'COMPLETADA').length}</dd>
        </div>
      </dl>
      <div className={styles.headerActions}>
        <Link href={`${baseRuta}/agenda?nueva=1&cliente=${cliente.id}`} className={styles.button}>
          <PanelIcon nombre="agenda" size={16} />
          Agendar
        </Link>
        <button
          className={styles.secondaryButton}
          onClick={() =>
            confirmClose(() => {
              clearPendingNotes();
              router.push(`${baseRuta}/mensajes?conversacion=${abrirConversacion(cliente.id)}`);
            })
          }
        >
          <PanelIcon nombre="mensajes" size={16} />
          Mensaje
        </button>
      </div>
      <h3 className={styles.miniTitle}>Sesiones</h3>
      {citas.length ? (
        citas.map((cita) => (
          <div className={styles.agendaItem} key={cita.id}>
            <time>{mostrarFecha(cita.fecha)}</time>
            <div>
              <h3>
                <Link href={`${baseRuta}/agenda?fecha=${cita.fecha}&cita=${cita.id}`}>
                  {cita.titulo}
                </Link>
              </h3>
              <p>
                {cita.hora} · {moneda(cita.importe)} ·{' '}
                {cita.estado === 'COMPLETADA'
                  ? 'Completada'
                  : cita.estado === 'CANCELADA'
                    ? 'Cancelada'
                    : 'Próxima sesión'}
              </p>
            </div>
          </div>
        ))
      ) : (
        <p className={styles.muted}>Todavía no hay sesiones.</p>
      )}
      <h3 className={styles.miniTitle}>Consultas</h3>
      {consultas.length ? (
        consultas.map((consulta) => (
          <p key={consulta.id}>
            <Link
              className={styles.textButton}
              href={`${baseRuta}/consultas?consulta=${consulta.id}`}
            >
              {consulta.titulo}
              <PanelIcon nombre="flecha" size={15} />
            </Link>
          </p>
        ))
      ) : (
        <p className={styles.muted}>Todavía no hay consultas.</p>
      )}
      <form
        onSubmit={(event) => {
          event.preventDefault();
          const error = guardarCliente({ ...cliente, notas }, cliente.id);
          setAviso(error || 'Notas guardadas.');
          if (!error) setNotas(notas.trim());
        }}
      >
        <div className={styles.field}>
          <label htmlFor="client-notes" className="mt-3">
            Notas privadas
          </label>
          <textarea
            id="client-notes"
            maxLength={1000}
            value={notas}
            onChange={(event) => setNotas(event.target.value)}
          />
        </div>
        <button type="submit" className={styles.secondaryButton}>
          Guardar notas
        </button>
      </form>
      {aviso && (
        <p className={`${styles.notice} mt-3`} role="status">
          {aviso}
        </p>
      )}
      <PanelReminderOverrides
        datos={datos}
        baseRuta={baseRuta}
        value={cliente.recordatorios}
        clienteId={cliente.id}
        onChange={(valor) => guardarExcepcionesCliente(cliente.id, valor)}
      />
    </>
  );
}

function ClientForm({
  cliente,
  onCancel,
  onSaved,
}: {
  cliente?: ClientePanel;
  onCancel: () => void;
  onSaved: () => void;
}) {
  const { datos, guardarCliente } = useClientPanel();
  return (
    <PanelForm<Omit<ClientePanel, 'id'>>
      initialValues={cliente || { nombre: '', email: '', telefono: '', ciudad: '', notas: '' }}
      validate={(values) => erroresCliente(values, datos.clientes, cliente?.id)}
      onSave={(values) => guardarCliente(values, cliente?.id)}
      onSaved={onSaved}
    >
      <PanelField
        name="nombre"
        label="Nombre completo"
        minLength={2}
        maxLength={80}
        required
        autoComplete="name"
      />
      <PanelField
        name="email"
        label="Email"
        type="email"
        maxLength={254}
        required
        autoComplete="email"
      />
      <PanelField name="telefono" label="Teléfono" type="tel" maxLength={30} autoComplete="tel" />
      <PanelField name="ciudad" label="Ciudad" as="select">
        <option value="">Sin indicar</option>
        {ciudadesEjemplo.map((ciudad) => (
          <option key={ciudad} value={ciudad}>
            {ciudad}
          </option>
        ))}
      </PanelField>
      <div className={styles.formActions}>
        <button type="button" onClick={onCancel} className={styles.secondaryButton}>
          Cancelar
        </button>
        <button type="submit" className={styles.button}>
          Guardar cliente
        </button>
      </div>
    </PanelForm>
  );
}
</file>

<file path="Front/src/components/panel/PanelReminderOverrides.tsx">
'use client';

import Link from 'next/link';
import type { DatosPanelArtista } from '@/types/panel-artista';
import { motivoRecordatorio, recordatoriosCliente } from '@/lib/recordatorios';
import type { ExcepcionesRecordatorios, RecordatorioCliente } from '@/types/recordatorios';
import styles from '@/components/panel/workspace.module.css';

export function PanelReminderOverrides({
  datos,
  baseRuta,
  value = {},
  onChange,
  clienteId,
  porTurno = false,
  cancelado = false,
}: {
  datos: Pick<DatosPanelArtista, 'recordatorios' | 'clientes' | 'citas'>;
  baseRuta: string;
  value?: ExcepcionesRecordatorios;
  onChange: (valor: ExcepcionesRecordatorios) => void;
  clienteId?: string;
  porTurno?: boolean;
  cancelado?: boolean;
}) {
  const cliente = datos.clientes.find((item) => item.id === clienteId);
  function elegir(tipo: RecordatorioCliente, valor: string) {
    const siguientes = { ...value };
    if (valor === '') delete siguientes[tipo];
    else siguientes[tipo] = valor === 'SI';
    onChange(siguientes);
  }
  return (
    <fieldset className={styles.reminderExceptions}>
      <legend>Recordatorios por correo</legend>
      <p>
        {porTurno
          ? 'Elegí excepciones para esta sesión. El resto conserva las preferencias del cliente.'
          : 'Personalizá los correos de este cliente sin cambiar las reglas generales.'}
      </p>
      {!datos.recordatorios.clientesHabilitados && (
        <p className={styles.muted}>
          Los envíos a clientes están desactivados en la configuración general.
        </p>
      )}
      {recordatoriosCliente.map((opcion) => {
        const heredado = porTurno
          ? (cliente?.recordatorios?.[opcion.id] ?? datos.recordatorios.reglas[opcion.id].activo)
          : datos.recordatorios.reglas[opcion.id].activo;
        return (
          <div className={styles.field} key={opcion.id}>
            <label htmlFor={`reminder-${porTurno ? 'turno' : 'cliente'}-${opcion.id}`}>
              {opcion.titulo}
            </label>
            <select
              id={`reminder-${porTurno ? 'turno' : 'cliente'}-${opcion.id}`}
              value={value[opcion.id] === undefined ? '' : value[opcion.id] ? 'SI' : 'NO'}
              onChange={(event) => elegir(opcion.id, event.target.value)}
            >
              <option value="">
                {porTurno ? 'Según cliente' : 'Según configuración general'} ·{' '}
                {heredado ? 'activado' : 'desactivado'}
              </option>
              <option value="SI">Activar</option>
              <option value="NO">No enviar</option>
            </select>
            <p className={styles.effectiveReminder}>
              {cancelado
                ? 'No se enviará: turno cancelado.'
                : motivoRecordatorio(datos, clienteId || '', opcion.id, value, porTurno)}
            </p>
          </div>
        );
      })}
      <Link href={`${baseRuta}/recordatorios`} className={styles.textButton}>
        Ver reglas generales
      </Link>
    </fieldset>
  );
}
</file>

<file path="Front/src/components/panel/PanelShell.tsx">
'use client';

import { useEffect, useState, type ReactNode } from 'react';
import { NavigationGuardLink as Link } from 'nextjs-nav-guard';
import NextLink from 'next/link';
import { usePathname, useRouter } from 'next/navigation';
import Offcanvas from 'react-bootstrap/Offcanvas';
import Dropdown from 'react-bootstrap/Dropdown';
import { useAuth } from '@/store/AuthProvider';
import { useDiscardChanges } from '@/components/forms/UnsavedChanges';
import { Avatar, PanelIcon, type IconoPanel } from './PanelUI';
import styles from './shell.module.css';

export interface PanelSection {
  nombre: string;
  ruta: string;
  icono: IconoPanel;
  grupo: string;
  cantidad?: number;
}
interface Props {
  children: ReactNode;
  secciones: PanelSection[];
  nombre: string;
  subtitulo: string;
  perfil: string;
}

function Navigation({
  secciones,
  nombre,
  subtitulo,
  close,
}: {
  secciones: PanelSection[];
  nombre: string;
  subtitulo: string;
  close?: () => void;
}) {
  const path = usePathname();
  const home = secciones[0]?.ruta || '/estudio';
  return (
    <>
      <Link href={home} className={styles.brand}>
        <span className={styles.brandMark}>im</span>
        <span className={styles.brandName}>InkManager</span>
      </Link>
      <nav aria-label="Panel del estudio" className={styles.navigation}>
        {[...new Set(secciones.map((s) => s.grupo))].map((grupo) => (
          <div className={styles.navGroup} key={grupo}>
            <p className={styles.groupLabel}>{grupo}</p>
            {secciones
              .filter((s) => s.grupo === grupo)
              .map((s) => (
                <Link
                  key={s.ruta}
                  href={s.ruta}
                  title={s.nombre}
                  aria-label={s.nombre}
                  aria-current={path === s.ruta ? 'page' : undefined}
                  className={path === s.ruta ? styles.active : ''}
                  onClick={(event) => {
                    if (path === s.ruta) {
                      event.preventDefault();
                      close?.();
                    }
                  }}
                >
                  <PanelIcon nombre={s.icono} size={19} />
                  <span className={styles.navLabel}>{s.nombre}</span>
                  {Boolean(s.cantidad) && <span className={styles.navCount}>{s.cantidad}</span>}
                </Link>
              ))}
          </div>
        ))}
      </nav>
      <div className={styles.sidebarFooter}>
        <PanelIcon nombre="estudio" />
        <div className={styles.footerLabel}>
          <strong>{nombre}</strong>
          <span>{subtitulo}</span>
        </div>
      </div>
      <Link href="/" className={styles.homeLink} title="Volver al inicio">
        <PanelIcon nombre="volver" size={17} />
        <span className={styles.navLabel}>Volver al inicio</span>
      </Link>
    </>
  );
}
function MobileNavigation(props: Pick<Props, 'secciones' | 'nombre' | 'subtitulo'>) {
  const [open, setOpen] = useState(false);
  return (
    <>
      <button
        className={`${styles.iconButton} ${styles.mobileToggle}`}
        aria-controls="studio-mobile-menu"
        aria-expanded={open}
        aria-label="Abrir menú"
        onClick={() => setOpen(true)}
      >
        <PanelIcon nombre="menu" />
      </button>
      <Offcanvas
        show={open}
        onHide={() => setOpen(false)}
        className={styles.mobileMenu}
        id="studio-mobile-menu"
        aria-label="Menú del estudio"
      >
        <Offcanvas.Header closeButton closeLabel="Cerrar">
          <Offcanvas.Title className="visually-hidden">Menú del estudio</Offcanvas.Title>
        </Offcanvas.Header>
        <Offcanvas.Body>
          <Navigation {...props} close={() => setOpen(false)} />
        </Offcanvas.Body>
      </Offcanvas>
    </>
  );
}
export function PanelShell({ children, secciones, nombre, subtitulo, perfil }: Props) {
  const { usuario, logout } = useAuth();
  const path = usePathname(),
    router = useRouter(),
    confirm = useDiscardChanges();
  const [compact, setCompact] = useState(() => {
    try {
      return localStorage.getItem('inkmanager:menu-compacto') === 'true';
    } catch {
      return false;
    }
  });
  const [error, setError] = useState(''),
    [leaving, setLeaving] = useState(false);
  useEffect(() => {
    try {
      localStorage.setItem('inkmanager:menu-compacto', String(compact));
    } catch {
      /* Preferencia opcional. */
    }
  }, [compact]);
  async function salir() {
    setLeaving(true);
    setError('');
    try {
      await logout();
      router.replace('/');
    } catch {
      setError('No pudimos cerrar la sesión. Intentá nuevamente.');
    } finally {
      setLeaving(false);
    }
  }
  return (
    <div className={`${styles.panel} ${compact ? styles.compact : ''}`} data-bs-theme="light">
      <a href="#panel-content" className={styles.skipLink}>
        Ir al contenido
      </a>
      <aside id="panel-sidebar" className={styles.sidebar}>
        <Navigation secciones={secciones} nombre={nombre} subtitulo={subtitulo} />
      </aside>
      <div className={styles.mainArea}>
        <header className={styles.topbar}>
          <div className={styles.breadcrumb}>
            <button
              className={`${styles.iconButton} ${styles.desktopToggle}`}
              aria-controls="panel-sidebar"
              aria-expanded={!compact}
              aria-label={compact ? 'Expandir menú' : 'Contraer menú'}
              onClick={() => setCompact(!compact)}
            >
              <PanelIcon nombre="menu" />
            </button>
            <MobileNavigation
              key={path}
              secciones={secciones}
              nombre={nombre}
              subtitulo={subtitulo}
            />
            <span>Mi estudio</span>
            <span className={styles.divider}>/</span>
            <strong>{secciones.find((s) => s.ruta === path)?.nombre || 'Consultas'}</strong>
          </div>
          <Dropdown key={path} align="end">
            <Dropdown.Toggle
              as="button"
              className={styles.account}
              aria-label={`Cuenta de ${usuario!.nombre || usuario!.email}`}
            >
              <Avatar nombre={usuario!.nombre || nombre} />
              <span className={styles.accountName}>
                <strong>{usuario!.nombre || nombre}</strong>
                <small>Titular del estudio</small>
              </span>
            </Dropdown.Toggle>
            <Dropdown.Menu>
              <div className={styles.accountEmail}>{usuario!.email}</div>
              <Dropdown.Item as={NextLink} href={perfil}>
                Perfil del estudio
              </Dropdown.Item>
              <Dropdown.Divider />
              <Dropdown.Item
                as="button"
                disabled={leaving}
                onClick={() =>
                  confirm(() => {
                    void salir();
                  })
                }
              >
                {leaving ? 'Cerrando…' : 'Cerrar sesión'}
              </Dropdown.Item>
            </Dropdown.Menu>
          </Dropdown>
        </header>
        {error && (
          <p className="alert alert-danger m-3" role="alert">
            {error}
          </p>
        )}
        <main id="panel-content" tabIndex={-1} className={styles.workspace}>
          {children}
        </main>
      </div>
    </div>
  );
}
</file>

