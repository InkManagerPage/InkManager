    estudioId: null,
  },
];
interface Acceso {
  id: string;
  nombre: string;
  email: string;
  password: string;
  rol: string;
  modalidad: string;
}
async function ejecutar() {
  await fs.mkdir(carpeta, { recursive: true });
  let anteriores: Acceso[] = [];
  try {
    anteriores = JSON.parse(await fs.readFile(archivo, "utf8"));
  } catch {
