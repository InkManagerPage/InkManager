'use client';
import { Suspense, useRef, useState } from 'react';
import Link from 'next/link';
import Modal from 'react-bootstrap/Modal';
import { useAuth } from '@/store/AuthProvider';
import { useConsultas } from '@/hooks/useConsultas';
import { useDisponibilidad } from '@/hooks/useDisponibilidad';
import { usePanelFilters } from '@/hooks/usePanelFilters';
import { useDiscardChanges } from '@/components/forms/UnsavedChanges';
import { PageHeader, EmptyState } from './PanelUI';
import { PanelForm, PanelSubmitButton } from './PanelForm';
import { WeeklyHoursEditor } from './WeeklyHoursEditor';
import { AvailabilityBlockForm } from './AvailabilityBlocks';
import { quitarBloqueo } from '@/services/disponibilidad.service';
import { mostrarFecha } from '@/lib/panel-artista';
import type { DisponibilidadAgenda, BloqueoAgenda } from '@/types/disponibilidad';
import styles from './workspace.module.css';
import horario from './availability.module.css';
export function AvailabilityWorkspace() {
  return (
    <Suspense fallback={<p role="status">Cargando disponibilidad…</p>}>
      <Availability />
    </Suspense>
  );
}
function Availability() {
  const { usuario } = useAuth(),
    consultas = useConsultas(),
    { params, update } = usePanelFilters(),
    descartar = useDiscardChanges();
  const fuente = consultas.datos;
  const titular = usuario?.rol === 'ESTUDIO_ADMIN',
    base = titular ? '/estudio' : '/artista';
  const artistaId = titular
    ? params.get('artista') || fuente?.equipo[0]?.id || ''
    : usuario?.id || '';
  const gestion = useDisponibilidad(artistaId),
    datos = gestion.datos;
  const [revision, setRevision] = useState(0),
    [aviso, setAviso] = useState(''),
    [pasados, setPasados] = useState(false);
  const [editor, setEditor] = useState<BloqueoAgenda | 'NUEVO' | null>(null),
    [eliminar, setEliminar] = useState<BloqueoAgenda | null>(null);
  const quitado = useRef<DisponibilidadAgenda | null>(null);
  function aplicar(d: DisponibilidadAgenda, mensaje: string) {
    gestion.aplicar(d);
    setRevision((r) => r + 1);
    setAviso(mensaje);
    setEditor(null);
    setEliminar(null);
  }
  function actualizar() {
    descartar(() => {
      setRevision((r) => r + 1);
      void gestion.recargar().then((d) => {
        if (d) {
          setRevision((r) => r + 1);
          setAviso('Disponibilidad actualizada.');
        }
      });
    });
  }
  function abrirEditor(bloqueo: BloqueoAgenda | 'NUEVO') {
    descartar(() => {
      setRevision((r) => r + 1);
      setEditor(bloqueo);
    });
  }
  function confirmarQuitar(bloqueo: BloqueoAgenda) {
    descartar(() => {
      setRevision((r) => r + 1);
      setEliminar(bloqueo);
    });
  }
  const bloques =
    datos?.bloqueos.filter((b) => pasados || new Date(b.finAt).getTime() > gestion.ahora) || [];
  return (
    <>
      <PageHeader
        titulo="Disponibilidad"
        descripcion={
          datos ? `${datos.artista.nombre} · ${datos.zonaHoraria.replaceAll('_', ' ')}` : undefined
        }
      >
        <button className={styles.secondaryButton} onClick={actualizar}>
          Actualizar
        </button>
        <Link
          className={styles.secondaryButton}
          href={`${base}/agenda${titular && artistaId ? `?artista=${artistaId}` : ''}`}
        >
          Ver agenda
        </Link>
      </PageHeader>
      {titular && (
        <label className={horario.artist}>
          Artista
          <select
            className="form-select"
            value={artistaId}
            onChange={(e) => {
              update({ artista: e.target.value });
              setAviso('');
            }}
          >
            {fuente?.equipo.map((a) => (
              <option value={a.id} key={a.id}>
                {a.nombre}
                {a.estado === 'SUSPENDIDO' ? ' · suspendido' : ''}
              </option>
            ))}
          </select>
        </label>
      )}
      {aviso && (
        <p className={styles.notice} role="status">
          {aviso}
        </p>
      )}
      {gestion.error && (
        <p className="alert alert-danger" role="alert">
          {gestion.error}
        </p>
      )}
      {titular && !fuente ? (
        consultas.cargando ? (
          <p role="status">Cargando equipo…</p>
        ) : (
          <p className="alert alert-danger" role="alert">
            {consultas.error || 'No pudimos cargar el equipo.'}{' '}
            <button
              className={styles.textButton}
              onClick={() => {
                void consultas.recargar();
              }}
            >
              Reintentar
            </button>
          </p>
        )
      ) : !artistaId ? (
        <EmptyState
          titulo={
            titular
              ? 'Agregá un artista al equipo para configurar su disponibilidad'
              : 'Cargando disponibilidad…'
          }
        />
      ) : gestion.cargando ? (
        <p role="status">Cargando disponibilidad…</p>
      ) : (
        datos && (
          <>
            {!datos.semana && (
              <p className={styles.notice}>
                Guardá los horarios de atención para habilitar nuevos turnos. Los turnos existentes
                se conservan.
              </p>
            )}
            {!datos.puedeEditar && (
              <p className={styles.notice}>
                Tu disponibilidad es de solo lectura mientras estés suspendido.
              </p>
            )}
            <WeeklyHoursEditor
              key={`${artistaId}:${revision}`}
              datos={datos}
              onReload={actualizar}
              onSaved={(d) => aplicar(d, 'Horarios guardados.')}
            />
            <section className={styles.surface}>
              <div className={styles.surfaceHeading}>
                <h2>Bloqueos de agenda</h2>
                {datos.puedeEditar && (
                  <button className={styles.secondaryButton} onClick={() => abrirEditor('NUEVO')}>
                    Agregar bloqueo
                  </button>
                )}
              </div>
              <div className={styles.surfaceBody}>
                <label className="form-check d-flex gap-2 align-items-center">
                  <input
                    className="form-check-input"
                    type="checkbox"
                    checked={pasados}
                    onChange={(e) => setPasados(e.target.checked)}
                  />
                  Mostrar bloqueos pasados
                </label>
              </div>
              {bloques.length ? (
                bloques.map((b) => (
                  <article className={styles.mobileItem} key={b.id}>
                    <strong>{b.motivo}</strong>
                    <p>
                      {mostrarFecha(b.desdeFecha, {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                      {b.diaCompleto
                        ? b.desdeFecha === b.hastaFecha
                          ? ' · Día completo'
                          : ` — ${mostrarFecha(b.hastaFecha, { day: 'numeric', month: 'short', year: 'numeric' })} · Días completos`
                        : ` ${b.desdeHora} — ${mostrarFecha(b.hastaFecha, { day: 'numeric', month: 'short', year: 'numeric' })} ${b.hastaHora}`}
                    </p>
                    {datos.puedeEditar && (
                      <div className={styles.headerActions}>
                        <button className={styles.textButton} onClick={() => abrirEditor(b)}>
                          Editar {b.motivo}
                        </button>
                        <button className={styles.textButton} onClick={() => confirmarQuitar(b)}>
                          Quitar {b.motivo}
                        </button>
                      </div>
                    )}
                  </article>
                ))
              ) : (
                <EmptyState titulo="No hay bloqueos en este período" />
              )}
            </section>
          </>
        )
      )}
      <Modal
        show={Boolean(editor)}
        centered
        scrollable
        fullscreen="sm-down"
        onHide={() => descartar(() => setEditor(null))}
      >
        <Modal.Header closeButton closeLabel="Cerrar">
          <Modal.Title as="h2" className="fs-5">
            {editor === 'NUEVO' ? 'Nuevo bloqueo' : 'Editar bloqueo'}
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {editor && datos && (
            <AvailabilityBlockForm
              datos={datos}
              bloqueo={editor === 'NUEVO' ? undefined : editor}
              onCancel={() => descartar(() => setEditor(null))}
              onSaved={(d) => aplicar(d, 'Bloqueo guardado.')}
            />
          )}
        </Modal.Body>
      </Modal>
      <Modal show={Boolean(eliminar)} centered onHide={() => setEliminar(null)}>
        <Modal.Header closeButton closeLabel="Cerrar">
          <Modal.Title as="h2" className="fs-5">
            Quitar bloqueo
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          {eliminar && datos && (
            <PanelForm
              initialValues={{ version: datos.version }}
              validate={() => ({})}
              onSave={async (v) => {
                quitado.current = await quitarBloqueo(artistaId, eliminar.id, v.version);
              }}
              onSaved={() => {
                if (quitado.current) aplicar(quitado.current, 'Bloqueo quitado.');
              }}
            >
              <p>
                Se quitará «{eliminar.motivo}». Ese período volverá a estar disponible según los
                horarios de atención.
              </p>
              <div className={styles.formActions}>
                <button
                  type="button"
                  className={styles.secondaryButton}
                  onClick={() => setEliminar(null)}
                >
                  Volver
                </button>
                <PanelSubmitButton pendingText="Quitando…">Quitar bloqueo</PanelSubmitButton>
              </div>
            </PanelForm>
          )}
        </Modal.Body>
      </Modal>
    </>
  );
}
</file>

<file path="Front/src/components/panel/BandejaMensajes.tsx">
'use client';
import { useCallback, useRef, useState } from 'react';
import { PanelMessages } from './PanelMessages';
import { ConexionWhatsApp } from './ConexionWhatsApp';
import { ConexionInstagram } from './ConexionInstagram';
import { PageHeader } from './PanelUI';
import { useConsultas } from '@/hooks/useConsultas';
import { mutarPanel, usePanelData } from '@/hooks/usePanelData';
import type { ConversacionPanel } from '@/types/panel-artista';

type Canal = ConversacionPanel['canal'];
type Bandeja = {
  conectado: boolean;
  administra: boolean;
  mostrarWhatsApp: boolean;
  conversaciones: ConversacionPanel[];
};
const ruta = (canal: Canal, id: string) => '/mensajes/' + canal.toLowerCase() + '/' + id;

export function BandejaMensajes({
  actualizarResumen,
  titular = false,
}: {
  actualizarResumen: () => Promise<void>;
  titular?: boolean;
}) {
  const { datos, error, cargando, recargar } = usePanelData<Bandeja>('/mensajes', 8000);
  const consultas = useConsultas();
  const [borradores, setBorradores] = useState<Record<string, string>>({});
  const [errorLectura, setErrorLectura] = useState('');
  const leyendo = useRef(new Set<string>());
  const intento = useRef<{ id: string; texto: string; clave: string } | null>(null);
  const leerConversacion = useCallback(
    async (id: string, canal: Canal, hasta: string) => {
      const clave = id + hasta;
      if (leyendo.current.has(clave)) return;
      leyendo.current.add(clave);
      try {
        await mutarPanel(ruta(canal, id) + '/lectura', 'PATCH', { hasta });
        setErrorLectura('');
        await Promise.all([recargar(), actualizarResumen()]);
      } catch (e) {
        setErrorLectura(
          e instanceof Error ? e.message : 'No pudimos marcar la conversación como leída.',
        );
      } finally {
        leyendo.current.delete(clave);
      }
    },
    [recargar, actualizarResumen],
  );

  if (!datos)
    return (
      <>
        <PageHeader titulo="Mensajes" />
        {cargando ? (
          <p role="status">Cargando conversaciones…</p>
        ) : (
          <div className="alert alert-danger" role="alert">
            {error}{' '}
            <button
              type="button"
              className="btn btn-sm btn-outline-dark"
              onClick={() => void recargar()}
            >
              Reintentar
            </button>
          </div>
        )}
      </>
    );

  async function enviarMensaje(id: string, canal: Canal, texto: string) {
    if (!intento.current || intento.current.id !== id || intento.current.texto !== texto)
      intento.current = { id, texto, clave: crypto.randomUUID() };
    await mutarPanel(ruta(canal, id), 'POST', { texto, clave: intento.current.clave });
    intento.current = null;
    await Promise.all([recargar(), actualizarResumen()]);
  }

  return (
    <PanelMessages
      datos={{ conversaciones: datos.conversaciones, borradoresMensajes: borradores }}
      conectado={datos.conectado}
      errorConexion={error || errorLectura}
      conexion={
        datos.administra ? (
          <div className="d-grid gap-2 mb-3">
            <ConexionInstagram alCambiar={recargar} />
            {titular && datos.mostrarWhatsApp && <ConexionWhatsApp alCambiar={recargar} />}
          </div>
        ) : undefined
      }
      consultas={consultas.datos?.contexto.administra ? consultas.datos.consultas : undefined}
      buscarCliente={(id) => {
        const c = datos.conversaciones.find((item) => item.id === id);
        return {
          id,
          nombre: c?.nombre || c?.telefono || 'Contacto',
          telefono: c?.telefono || '',
          email: '',
          ciudad: '',
          notas: '',
        };
      }}
      leerConversacion={leerConversacion}
      enviarMensaje={enviarMensaje}
      guardarBorradorMensaje={(id, texto) => setBorradores((d) => ({ ...d, [id]: texto }))}
      vincularConsulta={async (id, canal, solicitudId) => {
        await mutarPanel(ruta(canal, id) + '/consulta', 'PUT', { solicitudId });
        await Promise.all([recargar(), actualizarResumen()]);
      }}
    />
  );
}
</file>

<file path="Front/src/components/panel/ConexionInstagram.tsx">
'use client';

import { useState } from 'react';
import Modal from 'react-bootstrap/Modal';
import { useSearchParams } from 'next/navigation';
import { usePanelData } from '@/hooks/usePanelData';
import { apiFetch } from '@/lib/api-client';
import styles from './workspace.module.css';

type Conexion = {
  disponible: boolean;
  estado: 'CONECTADA' | 'VENCIDA' | 'SIN_CONEXION';
  usuario: string | null;
};

const ruta = '/mensajes/instagram/conexion';
const errores = {
  cancelado: 'Cancelaste la autorización de Instagram.',
  conflicto: 'La cuenta ya está vinculada. Revisá la conexión antes de intentarlo de nuevo.',
  sin_cuenta: 'Volvé a conectar y elegí una cuenta profesional de Instagram.',
  varias_cuentas: 'Volvé a conectar y seleccioná solo la cuenta que querés usar en la bandeja.',
  error: 'No pudimos conectar Instagram. Revisá los permisos de mensajes y volvé a intentarlo.',
};

export function ConexionInstagram({ alCambiar }: { alCambiar: () => Promise<void> }) {
  const { datos, cargando, error: errorConsulta, recargar } = usePanelData<Conexion>(ruta, 30000);
  const [confirmar, setConfirmar] = useState(false);
  const [ocupado, setOcupado] = useState(false);
  const [error, setError] = useState('');
  const resultado = useSearchParams().get('instagram');
  const aviso =
    resultado && Object.hasOwn(errores, resultado)
      ? errores[resultado as keyof typeof errores]
      : '';
  const conectada = datos?.estado === 'CONECTADA';

  async function desconectar() {
    setOcupado(true);
    setError('');
    try {
      await apiFetch(ruta, { method: 'DELETE', signal: AbortSignal.timeout(15000) });
      setConfirmar(false);
      await Promise.all([recargar(), alCambiar()]);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'No pudimos desconectar Instagram.');
    } finally {
      setOcupado(false);
    }
  }

  return (
    <section className={styles.surface} aria-labelledby="conexion-instagram">
      <div className={styles.surfaceHeading}>
        <h2 id="conexion-instagram">Instagram</h2>
        {conectada && datos.disponible && <strong>Conectado</strong>}
      </div>
      <div className={styles.surfaceBody}>
        {cargando && <p role="status">Consultando conexión…</p>}
        {errorConsulta && (
          <p role="alert">
            {errorConsulta}{' '}
            <button className={styles.textButton} onClick={() => void recargar()}>
              Reintentar
            </button>
          </p>
        )}
        {aviso && !conectada && (
          <p className="alert alert-warning" role="alert">
            {aviso}
          </p>
        )}
        {datos && (
          <>
            {!datos.disponible && <p>La conexión con Instagram todavía no está habilitada.</p>}
            {conectada && <p>@{datos.usuario}</p>}
            {datos.estado === 'VENCIDA' && (
              <p>Volvé a autorizar @{datos.usuario} para responder.</p>
            )}
            {datos.disponible && !conectada && (
              <a href="/api/mensajes/instagram/conectar" className={styles.button}>
                {datos.estado === 'VENCIDA' ? 'Volver a conectar' : 'Conectar Instagram'}
              </a>
            )}
            {(conectada || datos.estado === 'VENCIDA') && (
              <button className={styles.secondaryButton} onClick={() => setConfirmar(true)}>
                Desconectar
              </button>
            )}
          </>
        )}
      </div>
      <Modal
        show={confirmar}
        onHide={() => {
          if (!ocupado) setConfirmar(false);
        }}
        centered
        aria-labelledby="desconectar-instagram"
      >
        <Modal.Header closeButton={!ocupado} closeLabel="Cerrar">
          <Modal.Title as="h2" id="desconectar-instagram">
            Desconectar Instagram
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <p>
            La bandeja dejará de recibir mensajes de esta cuenta. El historial seguirá disponible.
          </p>
          {error && (
            <p className="alert alert-danger" role="alert">
              {error}
            </p>
          )}
          <button className="btn btn-danger" disabled={ocupado} onClick={() => void desconectar()}>
            {ocupado ? 'Desconectando…' : 'Confirmar desconexión'}
          </button>
        </Modal.Body>
      </Modal>
    </section>
  );
}
</file>

<file path="Front/src/components/panel/ConexionWhatsApp.tsx">
'use client';

import Script from 'next/script';
import { useEffect, useRef, useState, type FormEvent } from 'react';
import Modal from 'react-bootstrap/Modal';
import { apiFetch } from '@/lib/api-client';
import { mutarPanel, usePanelData } from '@/hooks/usePanelData';
import styles from './workspace.module.css';

type Meta = { appId: string; configId: string; version: string; intento: string };
type Conexion = {
  estado: 'SIN_CONEXION' | 'PILOTO' | 'REQUIERE_PIN' | 'PENDIENTE' | 'CONECTADA' | 'VENCIDA';
  telefono: string | null;
  meta: Meta | null;
};
type SDK = {
  init: (config: { appId: string; version: string }) => void;
  login: (
    callback: (respuesta: { authResponse?: { code?: string } } | undefined) => void,
    opciones: {
      config_id: string;
      response_type: 'code';
      override_default_response_type: true;
      extras: { version: 'v5' };
    },
  ) => void;
};
type Numero = { wabaIds: string[]; numeroId: string };
const origenesMeta = [
  'https://www.facebook.com',
  'https://web.facebook.com',
  'https://business.facebook.com',
];
const ruta = '/mensajes/whatsapp/conexion';

function leerEvento(evento: MessageEvent) {
  if (!origenesMeta.includes(evento.origin)) return null;
  try {
    const valor = typeof evento.data === 'string' ? JSON.parse(evento.data) : evento.data;
    return valor?.type === 'WA_EMBEDDED_SIGNUP'
      ? (valor as {
          event: string;
          data?: { waba_id?: string; messaging_account_ids?: string[]; phone_number_id?: string };
        })
      : null;
  } catch {
    return null;
  }
}

export function ConexionWhatsApp({ alCambiar }: { alCambiar: () => Promise<void> }) {
  const { datos, cargando, error: errorConsulta, recargar } = usePanelData<Conexion>(ruta, 30000);
  const [sdk, setSdk] = useState<SDK | null>(null);
  const [ocupado, setOcupado] = useState(false);
  const [error, setError] = useState('');
  const [confirmar, setConfirmar] = useState(false);
  const popup = useRef<(() => void) | null>(null);
  const estado = datos?.estado;
  const meta = datos?.meta;
  const pendiente = estado === 'REQUIERE_PIN' || estado === 'PENDIENTE';
  const permiteAlta = estado === 'SIN_CONEXION' || estado === 'VENCIDA' || estado === 'PILOTO';
  useEffect(() => () => popup.current?.(), []);

  async function ejecutar(accion: () => Promise<void>) {
    setOcupado(true);
    setError('');
    try {
      await accion();
    } catch (e) {
      setError(e instanceof Error ? e.message : 'No pudimos completar la conexión.');
    } finally {
      await Promise.all([recargar(), alCambiar()]);
      setOcupado(false);
    }
  }

  function abrir() {
    if (!meta || !sdk || popup.current || ocupado) return;
    const intento = meta.intento;
    let numero: Numero | undefined;
    let code: string | undefined;
    let esperaDatos: ReturnType<typeof setTimeout>;
    function cerrar() {
      clearTimeout(vencimiento);
      clearTimeout(esperaDatos);
      window.removeEventListener('message', alRecibir);
      popup.current = null;
    }
    function finalizar(mensaje: string) {
      if (popup.current !== cerrar) return;
      cerrar();
      setError(mensaje);
      setOcupado(false);
    }
    function completar() {
      if (!numero || !code || popup.current !== cerrar) return;
      const payload = { ...numero, code, intento };
      cerrar();
      void ejecutar(async () => {
        const respuesta = await mutarPanel(ruta, 'POST', payload);
        const { requierePin } = (await respuesta.json()) as { requierePin: boolean };
        if (!requierePin) await mutarPanel(ruta + '/activar', 'POST', {});
      });
    }
    function alRecibir(evento: MessageEvent) {
      const valor = leerEvento(evento);
      if (!valor) return;
      if (valor.event === 'CANCEL') finalizar('La conexión con Meta se canceló.');
      if (valor.event === 'ERROR') finalizar('Meta interrumpió la conexión. Volvé a intentarlo.');
      if (valor.event === 'FINISH_ONLY_WABA')
        finalizar('Elegí un número de WhatsApp en Meta para continuar.');
      if (valor.event !== 'FINISH' && valor.event !== 'FINISH_WHATSAPP_BUSINESS_APP_ONBOARDING')
        return;
      const { waba_id, messaging_account_ids, phone_number_id } = valor.data ?? {};
      const wabaIds = Array.isArray(messaging_account_ids)
        ? messaging_account_ids
        : waba_id
          ? [waba_id]
          : [];
      if (!wabaIds.length || !phone_number_id) {
        finalizar('Meta no devolvió un número. Revisá la configuración de Embedded Signup.');
        return;
      }
      numero = { wabaIds, numeroId: phone_number_id };
      completar();
    }
    setError('');
    setOcupado(true);
    popup.current = cerrar;
    window.addEventListener('message', alRecibir);
    const vencimiento = setTimeout(
      () => finalizar('El asistente tardó demasiado. Volvé a abrirlo.'),
      720000,
    );
    try {
      sdk.login(
        (respuesta) => {
          if (popup.current !== cerrar) return;
          code = respuesta?.authResponse?.code;
          if (!code) {
            finalizar('Meta no confirmó la autorización de WhatsApp.');
            return;
          }
          esperaDatos = setTimeout(
            () => finalizar('Meta no devolvió los datos del número.'),
            10000,
          );
          completar();
        },
        {
          config_id: meta.configId,
          response_type: 'code',
          override_default_response_type: true,
          extras: { version: 'v5' },
        },
      );
    } catch {
      finalizar('No pudimos abrir el asistente. Revisá el bloqueo de ventanas emergentes.');
    }
  }

  function activar(evento: FormEvent<HTMLFormElement>) {
    evento.preventDefault();
    const pin = new FormData(evento.currentTarget).get('pin');
    void ejecutar(async () => {
      await mutarPanel(ruta + '/activar', 'POST', pin ? { pin } : {});
    });
  }

  return (
    <section className={styles.surface} aria-labelledby="conexion-whatsapp">
      <div className={styles.surfaceHeading}>
        <h2 id="conexion-whatsapp">WhatsApp</h2>
        {estado === 'CONECTADA' && meta && <strong>Conectado</strong>}
      </div>
      <div className={styles.surfaceBody}>
        {cargando && <p role="status">Consultando conexión…</p>}
        {(error || errorConsulta) && (
          <p className="alert alert-danger" role="alert">
            {error || errorConsulta}
          </p>
        )}
        {!datos && errorConsulta && (
          <button className={styles.secondaryButton} onClick={() => void recargar()}>
            Reintentar
          </button>
        )}
        {datos && (
          <>
            {estado === 'CONECTADA' && <p>{datos.telefono}</p>}
            {!meta && estado !== 'PILOTO' && (
              <p>La conexión con Meta todavía no está habilitada.</p>
            )}
            {estado === 'VENCIDA' && <p>Volvé a autorizar {datos.telefono} en Meta.</p>}
            {estado === 'PILOTO' && <p>Número configurado por administración.</p>}
            {meta && estado === 'SIN_CONEXION' && (
              <p>Conectá el número de WhatsApp Business del estudio.</p>
            )}
            {meta && permiteAlta && (
              <>
                <Script
                  src="https://connect.facebook.net/es_LA/sdk.js"
                  crossOrigin="anonymous"
                  onReady={() => {
                    const facebook = (window as Window & { FB?: SDK }).FB;
                    if (!facebook) {
                      setError('No pudimos cargar el asistente de Meta.');
                      return;
                    }
                    try {
                      facebook.init({ appId: meta.appId, version: meta.version });
                      setSdk(facebook);
                    } catch {
                      setError('No pudimos iniciar el asistente de Meta.');
                    }
                  }}
                  onError={() => setError('No pudimos cargar el asistente de Meta.')}
                />
                <button className={styles.button} onClick={abrir} disabled={ocupado || !sdk}>
                  {ocupado
                    ? 'Conectando…'
                    : estado === 'VENCIDA'
                      ? 'Volver a conectar'
                      : 'Conectar con Meta'}
                </button>
              </>
            )}
            {pendiente && (
              <form onSubmit={activar} className="d-flex flex-wrap align-items-end gap-2 mb-2">
                {estado === 'REQUIERE_PIN' && (
                  <label>
                    PIN de verificación en dos pasos
                    <input
                      name="pin"
                      type="password"
                      className="form-control"
                      autoComplete="off"
                      inputMode="numeric"
                      pattern="[0-9]{6}"
                      maxLength={6}
                      required
                    />
                  </label>
                )}
                <button className={styles.button} type="submit" disabled={!meta || ocupado}>
                  {ocupado ? 'Activando…' : 'Activar WhatsApp'}
                </button>
              </form>
            )}
            {(pendiente || estado === 'CONECTADA' || estado === 'VENCIDA') && (
              <button
                className={styles.secondaryButton}
                disabled={ocupado}
                onClick={() => setConfirmar(true)}
              >
                Desconectar
              </button>
            )}
          </>
        )}
      </div>
      <Modal
        show={confirmar}
        onHide={() => {
          if (!ocupado) setConfirmar(false);
        }}
        centered
        aria-labelledby="desconectar-whatsapp"
      >
        <Modal.Header closeButton={!ocupado} closeLabel="Cerrar">
          <Modal.Title as="h2" id="desconectar-whatsapp">
            Desconectar WhatsApp
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <p>
            La bandeja dejará de recibir mensajes de este número. El historial seguirá disponible.
          </p>
          {error && (
            <p className="alert alert-danger" role="alert">
              {error}
            </p>
          )}
          <button
            className="btn btn-danger"
            disabled={ocupado}
            onClick={() =>
              void ejecutar(async () => {
                await apiFetch(ruta, { method: 'DELETE', signal: AbortSignal.timeout(15000) });
                setConfirmar(false);
              })
            }
          >
            {ocupado ? 'Desconectando…' : 'Confirmar desconexión'}
          </button>
        </Modal.Body>
      </Modal>
    </section>
  );
}
</file>

