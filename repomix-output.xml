import type { ContextoRegistro } from '@/types/forms';
const nombresRol = {
  CLIENTE: 'Cliente',
  ARTISTA: 'Artista',
  ESTUDIO_ADMIN: 'Estudio',
  SUPERADMIN: 'Administración',
};
export function AuthControls({
  light = false,
  onOpen,
  contextoRegistro = 'general',
}: {
  light?: boolean;
  onOpen?: () => void;
  contextoRegistro?: ContextoRegistro;
}) {
  const { usuario, cargando, error, reintentar, logout } = useAuth();
  const [modal, setModal] = useState<'login' | 'register' | null>(null);
  const [saliendo, setSaliendo] = useState(false);
  const [errorSalida, setErrorSalida] = useState('');
  function abrir(value: 'login' | 'register') {
    setModal(value);
    onOpen?.();
  }
  async function salir() {
    setSaliendo(true);
    setErrorSalida('');
    try {
      await logout();
    } catch (cause) {
      setErrorSalida(cause instanceof Error ? cause.message : 'No pudimos cerrar la sesión.');
    } finally {
      setSaliendo(false);
    }
  }
  return (
    <div className={`${styles.controls} ${light ? styles.light : ''}`}>
      {cargando ? (
        <span role="status">Consultando sesión…</span>
      ) : error ? (
        <div role="alert" className={styles.sessionError}>
          <span>{error}</span>
          <button onClick={reintentar}>Reintentar</button>
        </div>
      ) : usuario ? (
        <>
          <span className={styles.user}>
            <strong>{usuario.nombre || usuario.email}</strong>
            <small>{nombresRol[usuario.rol]}</small>
          </span>
          {usuario.rol !== 'CLIENTE' && (
            <Link
              href={
                usuario.rol === 'SUPERADMIN'
                  ? '/admin'
                  : usuario.rol === 'ARTISTA'
                    ? '/artista'
                    : '/estudio'
              }
              className={styles.linkButton}
              onClick={onOpen}
            >
              Mi panel
            </Link>
          )}
          <button className={styles.outline} onClick={salir} disabled={saliendo}>
            {saliendo ? 'Cerrando…' : 'Cerrar sesión'}
          </button>
          {errorSalida && (
            <span role="alert" className={styles.sessionError}>
              {errorSalida}
            </span>
          )}
        </>
      ) : (
        <>
          <button className={styles.linkButton} onClick={() => abrir('login')}>
            Iniciar sesión
          </button>
          <button className={styles.outline} onClick={() => abrir('register')}>
            Crear cuenta
          </button>
        </>
      )}
      {modal === 'login' && (
        <LoginModal show onHide={() => setModal(null)} onSwitch={() => setModal('register')} />
      )}
      {modal === 'register' && (
        <RegisterModal
          show
          contexto={contextoRegistro}
          onHide={() => setModal(null)}
          onSwitch={() => setModal('login')}
        />
      )}
    </div>
  );
}
</file>

<file path="Front/src/lib/api-client.ts">
// En el navegador usamos el mismo dominio para conservar la cookie de sesión.
export const apiUrl = '/api';
const serverApiUrl =
  process.env.API_URL || process.env.NEXT_PUBLIC_API_URL || 'http://127.0.0.1:4000/api';
export class ApiError extends Error {
  constructor(
    message: string,
    public status: number,
  ) {
    super(message);
    this.name = 'ApiError';
  }
}
export async function apiFetch(path: string, options: RequestInit = {}): Promise<Response> {
  const headers = new Headers(options.headers);
  headers.set('Accept', 'application/json');
  let response: Response;
  try {
    const baseUrl = typeof window === 'undefined' ? serverApiUrl : apiUrl;
    response = await fetch(`${baseUrl.replace(/\/+$/, '')}/${path.replace(/^\/+/, '')}`, {
      credentials: 'include',
      ...options,
      signal: options.signal ?? AbortSignal.timeout(15000),
      headers,
    });
  } catch (error) {
    if (error instanceof Error && error.name === 'AbortError') throw error;
    throw new Error('No pudimos conectar con InkManager. Intentá nuevamente.');
  }
  if (!response.ok) {
    const body: unknown = await response.json().catch(() => null);
    const message =
      body && typeof body === 'object' && 'error' in body && typeof body.error === 'string'
        ? body.error
        : 'No pudimos completar la operación. Intentá nuevamente.';
    throw new ApiError(message, response.status);
  }
  return response;
}
