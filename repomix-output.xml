});
conexion.post("/", async (req, res) => {
  const estudioId = await estudioDe(req.usuario!.id);
  res
    .status(201)
    .json(
      await guardarConexion(
        estudioId,
        verificarToken(req.cookies.inkmanager_session).sesionId,
