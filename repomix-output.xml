      a.tipo === "ESTUDIO"
        ? { estudioId: a.estudioId }
        : { artistaDestinoId: a.usuarioId, estudioId: null },
    ...(!a.administra || a.tipo === "INDEPENDIENTE"
      ? { artistaId: a.usuarioId }
      : {}),
  };
}
