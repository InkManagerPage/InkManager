<file path="Front/src/lib/comprimir-imagen.ts">
const MB = 1024 * 1024;

export async function comprimirImagen(archivo: File): Promise<File> {
  if (!['image/jpeg', 'image/png', 'image/webp'].includes(archivo.type)) {
    throw new Error('Usá una imagen JPG, PNG o WebP.');
  }
  if (archivo.size > 10 * MB) throw new Error('La foto original supera los 10 MB.');

  let imagen: ImageBitmap;
  try {
    imagen = await createImageBitmap(archivo);
  } catch {
    throw new Error('No pudimos abrir esa imagen. Probá con otra foto.');
  }
  const escala = Math.min(1, 1600 / Math.max(imagen.width, imagen.height));
  const canvas = document.createElement('canvas');
  canvas.width = Math.max(1, Math.round(imagen.width * escala));
  canvas.height = Math.max(1, Math.round(imagen.height * escala));
  const contexto = canvas.getContext('2d');
  if (!contexto) {
    imagen.close();
    throw new Error('No pudimos preparar la imagen.');
  }
  contexto.fillStyle = '#fff';
  contexto.fillRect(0, 0, canvas.width, canvas.height);
  contexto.drawImage(imagen, 0, 0, canvas.width, canvas.height);
  imagen.close();

  let comprimida: Blob | null = null;
  for (const calidad of [0.82, 0.65, 0.5]) {
    comprimida = await new Promise<Blob | null>((resolve) =>
      canvas.toBlob(resolve, 'image/jpeg', calidad),
    );
    if (comprimida && comprimida.size <= MB) break;
  }
  if (!comprimida || comprimida.size > 2 * MB) {
    throw new Error('La imagen optimizada supera los 2 MB. Elegí una foto más pequeña.');
  }
  return new File([comprimida], archivo.name.replace(/\.[^.]+$/, '') + '.jpg', {
    type: 'image/jpeg',
  });
}
</file>

<file path="Front/src/lib/disponibilidad.ts">
import type {
  SemanaDisponible,
  FormularioBloqueo,
  DisponibilidadAgenda,
} from '../types/disponibilidad';
import { leerFecha, moverFecha } from './panel-artista';
import { fechaValida } from './agenda';
export const diasSemana = [
  'Lunes',
  'Martes',
  'Miércoles',
  'Jueves',
  'Viernes',
  'Sábado',
  'Domingo',
];
export const minutos = (h: string) =>
  h === '24:00' ? 1440 : Number(h.slice(0, 2)) * 60 + Number(h.slice(3));
export function semanaInicial(): SemanaDisponible {
  return Array.from({ length: 7 }, (_, i) => ({
    dia: i + 1,
    rangos: i < 5 ? [{ desde: '09:00', hasta: '18:00' }] : [],
  }));
}
export function erroresSemana(semana: SemanaDisponible) {
  const errores: Record<string, string> = {};
  for (const d of semana) {
    const rangos = [...d.rangos].sort((a, b) => a.desde.localeCompare(b.desde));
    if (
      rangos.some(
        (r) =>
          !/^([01]\d|2[0-3]):[0-5]\d$/.test(r.desde) ||
          !/^(([01]\d|2[0-3]):[0-5]\d|24:00)$/.test(r.hasta) ||
          minutos(r.desde) >= minutos(r.hasta),
      )
    )
      errores[String(d.dia)] = 'Indicá un inicio anterior al final.';
    else if (rangos.some((r, i) => i > 0 && minutos(r.desde) < minutos(rangos[i - 1]!.hasta)))
      errores[String(d.dia)] = 'Los rangos de este día se superponen.';
  }
  return errores;
}
export function erroresBloqueo(v: FormularioBloqueo) {
  const errores: Partial<Record<keyof FormularioBloqueo, string>> = {};
  if (!v.motivo.trim() || v.motivo.trim().length > 120)
    errores.motivo = 'Ingresá un motivo de hasta 120 caracteres.';
  if (!fechaValida(v.desdeFecha)) errores.desdeFecha = 'Elegí una fecha válida.';
  if (!fechaValida(v.hastaFecha) || v.hastaFecha < v.desdeFecha)
    errores.hastaFecha = 'El final no puede ser anterior al inicio.';
  if (!v.diaCompleto) {
    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(v.desdeHora))
      errores.desdeHora = 'Elegí una hora válida.';
    if (
      !/^([01]\d|2[0-3]):[0-5]\d$/.test(v.hastaHora) ||
      v.hastaFecha + v.hastaHora <= v.desdeFecha + v.desdeHora
    )
      errores.hastaHora = 'El final debe ser posterior al inicio.';
  }
  return errores;
}
export function problemaReserva(
  d: DisponibilidadAgenda,
  fecha: string,
  hora: string,
  duracion: number,
) {
  if (!d.semana) return 'Configurá los horarios del artista antes de agendar.';
  const dia = leerFecha(fecha).getDay() || 7,
    desde = minutos(hora),
    hasta = desde + duracion;
  let cubierto = desde;
  for (const rango of d.semana.find((x) => x.dia === dia)?.rangos || []) {
    if (minutos(rango.desde) > cubierto) break;
    cubierto = Math.max(cubierto, minutos(rango.hasta));
    if (cubierto >= hasta) break;
  }
  if (cubierto < hasta) return 'El turno queda fuera de los horarios de atención.';
  const finFecha = hasta === 1440 ? moverFecha(fecha, 1) : fecha,
    finHora =
      hasta === 1440
        ? '00:00'
        : `${String(Math.floor(hasta / 60)).padStart(2, '0')}:${String(hasta % 60).padStart(2, '0')}`;
  const inicio = fecha + hora,
    fin = finFecha + finHora;
  if (
    d.bloqueos.some((b) => {
      const a = b.desdeFecha + (b.diaCompleto ? '00:00' : b.desdeHora),
        z =
          (b.diaCompleto ? moverFecha(b.hastaFecha, 1) : b.hastaFecha) +
          (b.diaCompleto ? '00:00' : b.hastaHora);
      return a < fin && z > inicio;
    })
  )
    return 'El artista tiene un bloqueo en ese horario.';
  return '';
}
</file>

<file path="Front/src/lib/estadisticas-artista.ts">
import type { CitaPanel, DatosPanelArtista } from '../types/panel-artista';
import { contarCanales } from './canales-consulta';
import { fechaLocal, leerFecha } from './panel-artista';

export function mesValido(mes: string): boolean {
  return /^\d{4}-(0[1-9]|1[0-2])$/.test(mes) && Number(mes.slice(0, 4)) > 0;
}

export function moverMes(mes: string, cantidad: number): string {
  const fecha = leerFecha(`${mes}-01`);
  fecha.setMonth(fecha.getMonth() + cantidad);
  return fechaLocal(fecha).slice(0, 7);
}

export function estadisticasMes(datos: DatosPanelArtista, mes: string) {
  if (!mesValido(mes)) throw new Error('Mes inválido.');
  const citas = datos.citas.filter((cita) => cita.fecha.slice(0, 7) === mes);
  const completadas = citas.filter((cita) => cita.estado === 'COMPLETADA');
  const anteriores = new Set(
    datos.citas
      .filter((cita) => cita.estado === 'COMPLETADA' && cita.fecha < `${mes}-01`)
      .map((cita) => cita.clienteId),
  );
  const clientes = new Set(completadas.map((cita) => cita.clienteId));
  const recurrentes = [...clientes].filter((id) => anteriores.has(id)).length;
  const facturacion = completadas.reduce((total, cita) => total + cita.importe, 0);
  const consultas = datos.consultas.filter((consulta) => consulta.fecha.slice(0, 7) === mes);
  const porCliente = [...clientes]
    .map((clienteId) => {
      const sesiones = completadas.filter((cita) => cita.clienteId === clienteId);
      return {
        clienteId,
        sesiones: sesiones.length,
        importe: sesiones.reduce((total, cita) => total + cita.importe, 0),
      };
    })
    .sort(
      (a, b) =>
        b.importe - a.importe || b.sesiones - a.sesiones || a.clienteId.localeCompare(b.clienteId),
    );
  const estados: CitaPanel['estado'][] = ['COMPLETADA', 'CONFIRMADA', 'PENDIENTE', 'CANCELADA'];
  return {
    turnos: citas.length,
    completados: completadas.length,
    cancelados: citas.filter((cita) => cita.estado === 'CANCELADA').length,
    clientes: clientes.size,
    nuevos: clientes.size - recurrentes,
    recurrentes,
    facturacion,
    ticketPromedio: completadas.length ? facturacion / completadas.length : 0,
    horas: completadas.reduce((total, cita) => total + cita.duracion, 0) / 60,
    consultas: consultas.length,
    presupuestadas: consultas.filter((consulta) => Boolean(consulta.presupuesto)).length,
    canales: contarCanales(consultas),
    estados: estados.map((estado) => ({
      estado,
      cantidad: citas.filter((cita) => cita.estado === estado).length,
    })),
    porCliente,
  };
}

export function evolucionFacturacion(datos: DatosPanelArtista, mes: string) {
  return Array.from({ length: 6 }, (_, indice) => {
    const periodo = moverMes(mes, indice - 5);
    return { mes: periodo, importe: estadisticasMes(datos, periodo).facturacion };
  });
}
</file>

