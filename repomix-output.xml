.header {
  position: sticky;
  top: 0;
  z-index: 1030;
  border-bottom: 1px solid var(--color-border, rgb(255 255 255 / 9%));
  background: rgb(9 9 11 / 82%);
  color: var(--color-text-primary, #f2f0ed);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}

.overlay {
  position: absolute;
  inset: 0 0 auto;
  background: linear-gradient(rgb(9 9 11 / 72%), rgb(9 9 11 / 22%));
}

.navbar {
  min-height: 76px;
  padding-block: 0;
  --bs-navbar-color: var(--color-text-muted, #a09da3);
  --bs-navbar-hover-color: var(--color-text-primary, #f2f0ed);
  --bs-navbar-brand-color: var(--color-text-primary, #f2f0ed);
  --bs-navbar-brand-hover-color: var(--color-text-primary, #f2f0ed);
  --bs-navbar-toggler-border-color: var(--color-border, rgb(255 255 255 / 9%));
}

.container {
  max-width: 90rem;
  min-height: inherit;
}

.brand,
.brand:hover {
  color: var(--color-text-primary, #f2f0ed);
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: -0.07em;
  text-decoration: none;
}

.toggle {
  box-shadow: none;
}

.toggle:focus-visible {
  outline: 2px solid var(--color-accent, #c58a68);
  outline-offset: 3px;
  box-shadow: none;
}

.collapse {
  flex-grow: 1;
}

.links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(1rem, 2.5vw, 2.25rem);
  margin-inline: auto;
}

.link {
  color: var(--color-text-muted, #a09da3);
  font-size: 0.875rem;
  text-decoration: none;
  text-underline-offset: 0.35em;
  transition: color 160ms ease;
}

.link:hover,
.link:focus-visible {
  color: var(--color-text-primary, #f2f0ed);
  text-decoration: underline;
}

.link:focus-visible {
  outline: 2px solid var(--color-accent, #c58a68);
  outline-offset: 4px;
}

.actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1rem;
  color: var(--color-text-primary, #f2f0ed);
}

@media (max-width: 991.98px) {
  .container {
    flex-wrap: wrap;
  }

  .collapse {
    flex-basis: 100%;
    padding-block: 0.75rem 1rem;
  }

  .links {
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding-bottom: 0.5rem;
  }

  .link {
    padding-block: 0.75rem;
  }

  .actions {
    justify-content: flex-start;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border, rgb(255 255 255 / 9%));
  }
}

@media (prefers-reduced-motion: reduce) {
  .link {
    transition: none;
  }
}
