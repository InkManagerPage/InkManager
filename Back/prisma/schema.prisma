generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                                     String             @id @default(uuid())
  email                                  String             @unique
  password                               String
  nombre                                 String?
  nombreArtistico                        String?
  alias                                  String?
  rol                                    Rol                @default(CLIENTE)
  telefono                               String?
  telefonoVerificado                     Boolean            @default(false)
  emailVerificado                        Boolean            @default(false)
  tokenVerificacionEmail                 String?
  fotoPerfil                             String?
  fotoTrabajando                         String?
  dniPasaporte                           String?
  documentoIdentidadUrl                  String?
  estadoVerificacion                     EstadoVerificacion @default(NO_VERIFICADO)
  tipoTrabajo                            TipoTrabajo?
  direccion                              String?
  ciudad                                 String?
  pais                                   String?
  radioAlcanceKm                         Int?               @default(20)
  horariosAtencion                       Json?
  estilosPrincipales                     String[]
  instagram                              String?
  tiktok                                 String?
  sitioWeb                               String?
  anosExperiencia                        Int?
  tarifaMinima                           Float?
  modalidadCobro                         ModalidadCobro?
  requiereSena                           Boolean            @default(true)
  montoPorcentajeSena                    Float?
  politicaCancelacion                    String?
  metodosPagoAceptados                   String[]
  cbuAliasBancario                       String?
  licenciaSanitariaUrl                   String?
  numeroLicencia                         String?
  aceptaDeclaracionHigiene               Boolean            @default(false)
  aceptaCoverUp                          Boolean            @default(true)
  aceptaCicatrices                       Boolean            @default(true)
  aceptaRetoques                         Boolean            @default(true)
  aceptaCaraManos                        Boolean            @default(false)
  copiaDisenosInternet                   Boolean            @default(false)
  tamanoMinimoCm                         Int?               @default(5)
  estudioId                              String?
  createdAt                              DateTime           @default(now())
  updatedAt                              DateTime           @updatedAt
  fotoPublicId                           String?
  resena                                 String?
  cotizaciones                           Cotizacion[]
  Estudio_Estudio_propietarioIdToUsuario Estudio[]          @relation("Estudio_propietarioIdToUsuario")
  FotoGaleria                            FotoGaleria[]
  solicitudes                            Solicitud[]        @relation("ClienteSolicitudes")
  estudio                                Estudio?           @relation(fields: [estudioId], references: [id])
}

model Estudio {
  id                                     String      @id @default(uuid())
  nombre                                 String
  slug                                   String      @unique
  direccion                              String?
  ciudad                                 String?
  pais                                   String?
  propietarioId                          String?
  createdAt                              DateTime    @default(now())
  updatedAt                              DateTime    @updatedAt
  Usuario_Estudio_propietarioIdToUsuario Usuario?    @relation("Estudio_propietarioIdToUsuario", fields: [propietarioId], references: [id])
  solicitudes                            Solicitud[]
  usuarios                               Usuario[]
}

model Solicitud {
  id                String            @id @default(uuid())
  clienteId         String
  estudioId         String?
  estilo            String
  tipoColor         TipoColor         @default(BLACK_AND_GREY)
  generoCuerpo      GeneroCuerpo      @default(MASCULINO)
  zonaGeneral       ZonaCuerpoGeneral
  subZona           String
  imagenZonaMarcada String?
  descripcion       String?
  referencias       String[]
  estado            EstadoSolicitud   @default(PENDIENTE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cotizaciones      Cotizacion[]
  cliente           Usuario           @relation("ClienteSolicitudes", fields: [clienteId], references: [id])
  estudio           Estudio?          @relation(fields: [estudioId], references: [id])
}

model Cotizacion {
  id          String    @id @default(uuid())
  solicitudId String
  artistaId   String
  monto       Float
  montoSena   Float
  mensaje     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  artista     Usuario   @relation(fields: [artistaId], references: [id])
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
}

model FotoGaleria {
  id            String   @id
  url           String
  esCicatrizado Boolean  @default(false)
  usuarioId     String
  createdAt     DateTime @default(now())
  Usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

enum Rol {
  CLIENTE
  ARTISTA
  ESTUDIO_ADMIN
  SUPERADMIN
}

enum GeneroCuerpo {
  MASCULINO
  FEMENINO
}

enum TipoColor {
  COLOR
  BLACK_AND_GREY
}

enum ZonaCuerpoGeneral {
  BRAZO
  MANO
  PIERNA
  TORSO
  CABEZA_CUELLO
}

enum EstadoSolicitud {
  PENDIENTE
  EN_COTIZACION
  ACEPTADO
  CANCELADO
}

enum EstadoVerificacion {
  NO_VERIFICADO
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

enum ModalidadCobro {
  POR_HORA
  POR_SESION
  POR_PIEZA
}

enum TipoTrabajo {
  ESTUDIO_PROPIO
  RESIDENTE
  GUEST_SPOT
  PRIVADO
}
