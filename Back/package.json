{
  "name": "back",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:pagos": "prisma db execute --file prisma/changes/20261031_suscripciones.sql --schema prisma/schema.prisma",
    "db:pagos:unificar": "prisma db execute --file prisma/changes/20261110_unificar_pagos.sql --schema prisma/schema.prisma",
    "db:security": "prisma db execute --file prisma/changes/20261020_rls.sql --schema prisma/schema.prisma",
    "db:reviews": "prisma db execute --file prisma/changes/20261020_artistas_resenas.sql --schema prisma/schema.prisma",
    "seed:reviews": "tsx prisma/seed-reviews.ts",
    "seed:catalogo": "tsx prisma/seed-catalogo.ts",
    "db:consultas": "prisma db execute --file prisma/changes/20261102_consultas_compartidas.sql --schema prisma/schema.prisma",
    "seed:recorrido": "tsx prisma/seed-recorrido.ts",
    "db:integridad-consultas": "prisma db execute --file prisma/changes/20261102_integridad_consultas.sql --schema prisma/schema.prisma",
    "db:turnos": "prisma db execute --file prisma/changes/20261102_turnos.sql --schema prisma/schema.prisma",
    "seed:turnos": "tsx prisma/seed-turnos.ts",
    "db:equipo": "prisma db execute --file prisma/changes/20261102_equipo.sql --schema prisma/schema.prisma",
    "db:disponibilidad": "prisma db execute --file prisma/changes/20261102_disponibilidad.sql --schema prisma/schema.prisma",
    "db:operacion": "prisma db execute --file prisma/changes/20261106_operacion.sql --schema prisma/schema.prisma",
    "admin:habilitar": "tsx prisma/habilitar-admin.ts",
    "db:whatsapp": "prisma db execute --file prisma/changes/20261106_whatsapp_estudios.sql --schema prisma/schema.prisma",
    "db:mensajes": "prisma db execute --file prisma/changes/20261106_mensajes_canales.sql --schema prisma/schema.prisma",
    "db:instagram": "prisma db execute --file prisma/changes/20261109_instagram_login_unificado.sql --schema prisma/schema.prisma",
    "db:piloto-instagram": "prisma db execute --file prisma/changes/20261110_piloto_instagram.sql --schema prisma/schema.prisma",
    "db:asistente": "prisma db execute --file prisma/changes/20261111_configuracion_asistente.sql --schema prisma/schema.prisma",
    "db:chatbot-turnos": "prisma db execute --file prisma/changes/20261112_chatbot_propuestas_turnos.sql --schema prisma/schema.prisma",
    "db:instagram-agenda": "prisma db execute --file prisma/changes/20261112_instagram_agenda.sql --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tansuasici/country-state-city": "3.0.3",
    "bcryptjs": "3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "3.7.2",
    "mercadopago": "^3.6.1",
    "multer": "^2.5.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "nodemon": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
