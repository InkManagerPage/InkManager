PORT=4000
DATABASE_URL=postgresql://usuario:password@servidor:5432/postgres
DIRECT_URL=postgresql://usuario:password@servidor:5432/postgres
SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generar una clave aleatoria propia de al menos 32 bytes.
JWT_SECRET=
FRONTEND_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# preview guarda correos locales; resend los envía realmente.
MAIL_TRANSPORT=preview
RESEND_API_KEY=
MAIL_FROM=
RECORDATORIOS_AUTOMATICOS=0

# Mercado Pago: usar credenciales de prueba para probar el checkout.
# Activar cobros en producción después de verificar checkout y webhooks en pruebas.
MERCADOPAGO_COBROS_ACTIVOS=0
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS que Mercado Pago pueda alcanzar (por ejemplo, un túnel de desarrollo).
MERCADOPAGO_WEBHOOK_URL=

# Meta Embedded Signup. La clave de cifrado debe tener 64 caracteres hexadecimales.
WHATSAPP_APP_ID=
WHATSAPP_CONFIG_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TOKEN_KEY=

# Número piloto opcional. Completar exactamente uno de los dos IDs de negocio.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ESTUDIO_ID=
WHATSAPP_ARTISTA_ID=

# Instagram con inicio de sesión unificado de Meta.
INSTAGRAM_META_APP_ID=
INSTAGRAM_META_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_TOKEN_KEY=
# Opcional. Activa el bot únicamente para el estudio identificado por este slug.
INSTAGRAM_BOT_ESTUDIO_SLUG=

# Opcionales para instalaciones con el inicio de sesión anterior de Instagram.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_SECRET=
