# URL privada del backend, también usada por el proxy /api del frontend.
API_URL=http://127.0.0.1:4000/api

# Clave pública de Mercado Pago; nunca colocar aquí el access token.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Solo para el servidor Next.js; usar los mismos valores configurados en Back/.env.
RESEND_API_KEY=
MAIL_FROM=
